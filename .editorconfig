# How the files here are already written, so an editor keeps to it: spaces,
# LF, one final newline, no trailing blanks. Two spaces for TypeScript,
# JavaScript, CSS, HTML, YAML, shell and Markdown; four where each
# language's own formatter or convention says so (ruff for Python,
# rustfmt, Swift, Kotlin, Java, XML, TOML, SQL). Measured over every
# tracked file on 2026-11-08; the exceptions below are files written as
# their sources write them, which an editor should leave as they are.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,pyi,rs,swift,kt,kts,java,xml,toml,sql}]
indent_size = 4

# Hard breaks in Markdown are two trailing spaces.
[*.md]
trim_trailing_whitespace = false

# Written by tools: the asset catalogues, the e2e fixtures and the
# diagrams' exports have no final newline.
[*.{json,svg,drawio}]
insert_final_newline = unset

# Caddy's own files and Spring Session's schema are indented with tabs.
[{Caddyfile,Caddyfile.*,V8__spring_session.sql}]
indent_style = tab

# make's recipes must start with a tab.
[Makefile]
indent_style = tab

# Windows' Gradle wrapper, and data as its source writes it.
[*.bat]
end_of_line = crlf

[*.csv]
end_of_line = unset
trim_trailing_whitespace = false

# The FAA's CIFP file, fixed-width records kept byte for byte.
[FAACIFP*]
trim_trailing_whitespace = false
insert_final_newline = unset

# ktlint's settings for the Android app (scripts/dev/format.sh kotlin, the
# version it pins), which ktlint reads from here. Layout only, matched to
# how the files were written before the formatter came in (2026-11-09) so
# it reflowed as little as it could: IntelliJ's style, with no line width
# (the code is wrapped by hand, as Android Studio leaves it), and none of
# the rules that unfold what is written on one line (arguments, signatures,
# chains, if/else and when bodies) or put a blank line between members.
# The naming and KDoc rules are lint, not layout, and ktlint cannot fix
# them; Android lint and review keep to those.
[*.{kt,kts}]
ktlint_code_style = intellij_idea
max_line_length = off
ktlint_standard_argument-list-wrapping = disabled
ktlint_standard_binary-expression-wrapping = disabled
ktlint_standard_blank-line-between-when-conditions = disabled
ktlint_standard_chain-method-continuation = disabled
ktlint_standard_class-signature = disabled
ktlint_standard_enum-wrapping = disabled
ktlint_standard_function-literal = disabled
ktlint_standard_function-signature = disabled
ktlint_standard_if-else-wrapping = disabled
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_standard_multiline-if-else = disabled
ktlint_standard_multiline-loop = disabled
ktlint_standard_parameter-list-wrapping = disabled
ktlint_standard_property-wrapping = disabled
ktlint_standard_spacing-between-declarations-with-annotations = disabled
ktlint_standard_spacing-between-declarations-with-comments = disabled
ktlint_standard_statement-wrapping = disabled
ktlint_standard_wrapping = disabled
# These two need the wrapping rule above.
ktlint_standard_trailing-comma-on-call-site = disabled
ktlint_standard_trailing-comma-on-declaration-site = disabled
ktlint_standard_filename = disabled
ktlint_standard_function-naming = disabled
ktlint_standard_kdoc = disabled
ktlint_standard_mixed-condition-operators = disabled
ktlint_standard_property-naming = disabled
