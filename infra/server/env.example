# What the production server's .env holds (deploy.sh writes it; never
# edit it on the server). Three sources:
#
# 1. The stack itself, through /etc/wingtip.conf:
#      IMAGE_REGISTRY, PUBLIC_HOST, ORIGIN_HOST, MAIL_HOST, MAIL_FROM
# 2. Secrets the stack generates: POSTGRES_PASSWORD, ORIGIN_SECRET
# 3. The owner's values, as one JSON secret (the stack's AppSecret,
#    filled in the Secrets Manager console after the first deploy):
#
# The switches are not here: infra/docker-compose.prod.yml sets them, the
# charts' drawing off (CHARTS_AUTO_REFRESH=0), the FAA's NASR and
# obstacle files' refresh on (FAA_DATA_AUTO_REFRESH=1).
{
  "MAIL_USERNAME": "SES SMTP user name (SES console, SMTP settings, Create SMTP credentials)",
  "MAIL_PASSWORD": "SES SMTP password, from the same page",
  "APP_DEVELOPER_EMAILS": "addresses that see the developer console, comma-separated",
  "APP_ALERT_EMAILS": "optional: where the monitor's alerts go (a service down 5 minutes, a feed stale), comma-separated; the developers' addresses where unset (docs/OPERATIONS.md)",
  "APP_SPEED_LAB_TOKEN": "optional: a long random string, also GitHub's SPEED_LAB_TOKEN secret, so the nightly speed lab reaches the Speed page",
  "REVIEW_SIGN_IN": "optional, false unless a build is in store review: true lets the review account below sign in with its code (docs/store/listing.md, Review access); set it back to false after",
  "REVIEW_SIGN_IN_EMAIL": "with it: the review account's address, one used for nothing else (review@ on the site's domain)",
  "REVIEW_SIGN_IN_CODE": "with it: a random string of at least 20 characters, given to the reviewers in the review notes; change it after each review",
  "SPRING_PROFILES_ACTIVE": "optional: oauth, once the Google or Apple values below are in",
  "GOOGLE_CLIENT_ID": "optional: Sign in with Google",
  "GOOGLE_CLIENT_SECRET": "optional",
  "APPLE_TEAM_ID": "optional: Sign in with Apple",
  "APPLE_KEY_ID": "optional",
  "APPLE_SERVICES_ID": "optional",
  "APPLE_PRIVATE_KEY": "optional",
  "APP_IOS_BUNDLE_ID": "the iOS app's bundle id (docs/NATIVE.md); with APPLE_TEAM_ID, links to the site open in the app",
  "APP_ANDROID_PACKAGE": "the Android app's package name (docs/NATIVE-ANDROID.md)",
  "APP_ANDROID_CERT_SHA256": "with it, the SHA-256 fingerprints of Play's app signing key and the upload key, comma-separated: links to the site open in the app",
  "GOOGLE_MAPS_API_KEY": "optional: a browser key for Google's Map Tiles API, restricted to the site's referrer and to the Map Tiles API alone, with daily quotas and a budget alert (docs/GOOGLE-MAPS.md, the owner's console steps); the map's Google overlay",
  "ADSBX_RAPIDAPI_KEY": "optional: an ADS-B Exchange key from RapidAPI, the traffic's fallback where adsb.lol refuses; 9,000 requests a month at most (wingtip.traffic)",
  "SWIM_HOST": "optional: the FAA SWIM broker from the SCDS subscription's Details page (tcps://ems2.swim.faa.gov:55443); with the rest below, ingest reads the feeds (services/ingest)",
  "SWIM_USERNAME": "optional: the SCDS subscription's user name",
  "SWIM_PASSWORD": "optional: its password",
  "SWIM_VPN_STDDS": "optional: STDDS's message VPN (terminal radar)",
  "SWIM_QUEUE_STDDS": "optional: STDDS's queue",
  "SWIM_VPN_FNS": "optional: FNS's message VPN (NOTAMs)",
  "SWIM_QUEUE_FNS": "optional: FNS's queue",
  "SWIM_HOST_TFMS": "optional: TFMS's own broker where SCDS put it on another (ems1)",
  "SWIM_VPN_TFMS": "optional: TFMS's message VPN (flight plans)",
  "SWIM_QUEUE_TFMS": "optional: TFMS's queue",
  "SWIM_VPN_ITWS": "optional: ITWS's message VPN (microburst, wind shear and storm alerts), on SWIM_HOST's broker",
  "SWIM_QUEUE_ITWS": "optional: ITWS's queue",
  "SWIM_VPN_SFDPS": "optional: SFDPS's message VPN (special activity airspace status), on SWIM_HOST's broker",
  "SWIM_QUEUE_SFDPS": "optional: SFDPS's queue"
}
