# The production server's front door (infra/docker-compose.prod.yml's caddy).
#
# CloudFront is the only client: the security group admits port 443 from
# CloudFront's origin-facing addresses alone, and every request must carry
# the secret header CloudFront adds (X-Origin-Secret, from the stack's
# OriginSecret). Caddy gets the certificate for ORIGIN_HOST from Let's
# Encrypt by itself over port 80, which is open for that and redirects
# everything else to HTTPS.

{$ORIGIN_HOST} {
	# An answer the gateway has already encoded (the web build's Brotli,
	# WebMvcConfig) passes through as it is; these are for the rest.
	encode zstd gzip

	# The routes only the planner calls, over the compose network to the
	# gateway's internal port (8081, InternalPortConfig); the gateway
	# refuses them on 8080 too, and this keeps them off the internet
	# whatever it does (the security audit's M2, 2026-11-10).
	handle /internal/* {
		respond "Not found" 404
	}

	@cloudfront header X-Origin-Secret {$ORIGIN_SECRET}

	# The map's tiles go straight to the planner, not through the gateway:
	# the chart's raster tiles, the terrain's and the overlays' archive
	# with its index. They are public (the planner marks them SHARED,
	# app.gateway) and the same for every pilot, and through Spring each
	# one carried some 1.2 KB of headers a pilot's tile never needs -- a
	# fresh XSRF-TOKEN cookie, the page's CSP, chunked encoding -- and a
	# second hop (audit/tiles.md #2). Only these addresses, written out
	# whole, reach the planner this way, by GET or HEAD: the planner
	# trusts the gateway's X-Pilot-Id on other routes, so nothing else of
	# its may be reached but through the gateway, and the request's
	# cookies and any X-Pilot-Id are dropped on the way.
	@tiles {
		header X-Origin-Secret {$ORIGIN_SECRET}
		method GET HEAD
		path_regexp ^/api/planner/(chart-tile/[a-z_]+/[0-9]+/[0-9]+/[0-9]+(@2x)?\.png|terrain-tile/[0-9]+/[0-9]+/[0-9]+\.png|overlay-tiles(/[A-Za-z0-9._-]+\.pmtiles)?)$
	}
	handle @tiles {
		# The gateway hands /api/planner/X to the planner as /api/X
		# (UpstreamRoutes), so this does the same: stripping the whole
		# prefix asked the planner for /chart-tile/..., a 404. And the
		# planner answers only its own names (app/local_guard.py), so it is
		# asked as "planner", not by the origin's name, which it refuses.
		uri replace /api/planner/ /api/ 1
		reverse_proxy planner:8000 {
			header_up Host planner
			header_up -Cookie
			header_up -X-Pilot-Id
			header_up -X-Origin-Secret
			header_up -Forwarded
			header_up -X-Forwarded-Prefix
			header_down X-Content-Type-Options nosniff
		}
	}

	handle @cloudfront {
		# The pilot's address is the last one in X-Forwarded-For: CloudFront
		# appends the viewer's to whatever the request came with, and only
		# CloudFront reaches this server. The gateway's per-client limits
		# (SlidingWindowLimiter, through Tomcat's RemoteIpValve) take it from
		# here, so it is passed on alone -- appended to, the valve would
		# have CloudFront's own address as the last untrusted hop.
		map {http.request.header.X-Forwarded-For} {viewer_ip} {
			~(?:^|,\s*)([^,\s]+)\s*$ "${1}"
			default {remote_host}
		}
		reverse_proxy gateway:8080 {
			header_up X-Forwarded-For {viewer_ip}
			header_up X-Forwarded-Proto https
			# Links and redirects the gateway builds name the public domain,
			# not this origin's.
			header_up X-Forwarded-Host {$PUBLIC_HOST}
			header_up -X-Origin-Secret
			# Sent by a viewer, CloudFront passes on RFC 7239's Forwarded,
			# X-Forwarded-Prefix, -Port and -Ssl, which would change the host,
			# path or port of the links the gateway builds (the share page's,
			# the sign-in redirects', an OAuth redirect_uri). The gateway's
			# RemoteIpValve reads none of them (application.yml), and they
			# are dropped here too, so only the X-Forwarded-* set above
			# reaches it (the security audit's L2; round 4's L13).
			header_up -Forwarded
			header_up -X-Forwarded-Prefix
			header_up -X-Forwarded-Port
			header_up -X-Forwarded-Ssl
		}
	}

	handle {
		respond "Not found" 404
	}
}
