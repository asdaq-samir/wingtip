# The production server's front door (infra/docker-compose.prod.yml's caddy).
#
# CloudFront is the only client: the security group admits port 443 from
# CloudFront's origin-facing addresses alone, and every request must carry
# the secret header CloudFront adds (X-Origin-Secret, from the stack's
# OriginSecret). Caddy gets the certificate for ORIGIN_HOST from Let's
# Encrypt by itself over port 80, which is open for that and redirects
# everything else to HTTPS.

{$ORIGIN_HOST} {
	# An answer the gateway has already encoded (the web build's Brotli,
	# WebMvcConfig) passes through as it is; these are for the rest.
	encode zstd gzip

	# The routes only the planner calls, over the compose network to the
	# gateway's internal port (8081, InternalPortConfig); the gateway
	# refuses them on 8080 too, and this keeps them off the internet
	# whatever it does (the security audit's M2, 2026-11-10).
	handle /internal/* {
		respond "Not found" 404
	}

	@cloudfront header X-Origin-Secret {$ORIGIN_SECRET}
	handle @cloudfront {
		# The pilot's address is the last one in X-Forwarded-For: CloudFront
		# appends the viewer's to whatever the request came with, and only
		# CloudFront reaches this server. The gateway's per-client limits
		# (SlidingWindowLimiter) read the last entry, so it is passed on
		# alone -- appended to, it would be CloudFront's own address.
		map {http.request.header.X-Forwarded-For} {viewer_ip} {
			~(?:^|,\s*)([^,\s]+)\s*$ "${1}"
			default {remote_host}
		}
		reverse_proxy gateway:8080 {
			header_up X-Forwarded-For {viewer_ip}
			header_up X-Forwarded-Proto https
			# Links and redirects the gateway builds name the public domain,
			# not this origin's.
			header_up X-Forwarded-Host {$PUBLIC_HOST}
			header_up -X-Origin-Secret
			# Spring reads RFC 7239's Forwarded ahead of X-Forwarded-Host
			# (forward-headers-strategy: framework), and X-Forwarded-Prefix
			# beside it: sent by a viewer, CloudFront passes them on, and
			# they would change the host and path of every link the gateway
			# builds (the share page's, the sign-in redirects'). Only the
			# X-Forwarded-* set above reaches it (the security audit's L2).
			header_up -Forwarded
			header_up -X-Forwarded-Prefix
		}
	}

	handle {
		respond "Not found" 404
	}
}
