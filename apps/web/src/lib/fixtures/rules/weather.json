      ],
      "source": "14 CFR 1.1: \"Ceiling means the height above the earth's surface of the lowest layer of clouds or obscuring phenomena that is reported as 'broken', 'overcast', or 'obscuration', and not classified as 'thin' or 'partial'.\""
    },
    {
      "name": "1,600 m is 0.99 statute miles, said as 15/16, the step at or below",
      "rule": "ceiling_visibility",
      "input": {
        "visibility": {
          "value": 1600,
          "unit": "m"
        }
      },
      "expect": [
        {
          "path": "visibility_sm",
          "value": 0.9375,
          "tolerance": 0
        }
      ],
      "source": "A statute mile is 1,609.344 m (the international mile, NIST Handbook 44 Appendix C); a METAR's visibility in the US is in statute miles (AIM 7-1-28). A US report gives sixteenths below 3 sm and never rounds a visibility up (FAA JO 7900.5E's reportable values), so the engine says the step at or below (metres_to_sm)."
    },
    {
      "name": "5,000 m is 3.11 statute miles, said as 3, the step at or below",
      "rule": "ceiling_visibility",
      "input": {
        "visibility": {
          "value": 5000,
          "unit": "m"
        }
      },
      "expect": [
        {
          "path": "visibility_sm",
          "value": 3.0,
          "tolerance": 0
        }
      ],
      "source": "A statute mile is 1,609.344 m (the international mile, NIST Handbook 44 Appendix C); a METAR's visibility in the US is in statute miles (AIM 7-1-28). From 3 sm a US report gives whole miles and never rounds a visibility up (FAA JO 7900.5E's reportable values), so the engine says 3 (metres_to_sm)."
    },
    {
      "name": "2 1/2 SM is 2.5",
      "rule": "ceiling_visibility",
      "input": {
        "visibility": {
          "value": 2.5,
          "unit": "sm"
        }
      },
      "expect": [
        {
          "path": "visibility_sm",
          "value": 2.5,
          "tolerance": 0
        }
      ],
      "source": "A statute mile is 1,609.344 m (the international mile, NIST Handbook 44 Appendix C); a METAR's visibility in the US is in statute miles (AIM 7-1-28)."
    },
    {
      "name": "-FZRA in a METAR and FZDZ in a TAF are freezing precipitation; FZFG and a remark are not",
      "rule": "freezing_precip",
      "input": {
        "fields": [
          {
            "ident": "KDLH",
            "metar": "KDLH 211253Z 05012KT 3SM -FZRA BR OVC008 M02/M03 A2990 RMK FZRAB15",
            "taf": "KDLH 211120Z 2112/2212 04010KT 5SM -SN OVC015 TEMPO 2114/2118 1SM FZDZ"
          },
          {
            "ident": "KMSP",
            "metar": "KMSP 211253Z 36008KT 1/2SM FZFG OVC003 M05/M06 A3010",
            "taf": null
          }
        ]
      },
      "expect": [
        {
          "path": "found",
          "length": 2
        },
        {
          "path": "found.0.group",
          "equals": "-FZRA"
        },
        {
          "path": "found.0.source",
          "equals": "METAR"
        },
        {
          "path": "found.1.group",
          "equals": "FZDZ"
        },
        {
          "path": "found.1.source",
          "equals": "TAF"
        },
        {
          "path": "line",
          "contains": "KDLH"
        }
      ],
      "source": "AIM 7-1-20: \"Freezing precipitation is freezing rain or freezing drizzle falling through or outside of visible cloud.\" A METAR's remarks (FZRAB15, when it began) are no report of it now; freezing fog (FZFG) is no precipitation."
    },
    {
      "name": "Snow at freezing temperatures is no freezing precipitation",
      "rule": "freezing_precip",
      "input": {
        "fields": [
          {
            "ident": "KMSP",
            "metar": "KMSP 211253Z 36008KT 10SM -SN OVC030 M05/M10 A3010"
          }
        ]
      },
      "expect": [
        {
          "path": "found",
          "length": 0
        },
        {
          "path": "line",
          "equals": null
        }
      ],
      "source": "AIM 7-1-20: \"Freezing precipitation is freezing rain or freezing drizzle falling through or outside of visible cloud.\" A METAR's remarks (FZRAB15, when it began) are no report of it now; freezing fog (FZFG) is no precipitation."
    },
