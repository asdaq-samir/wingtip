{
  "_note": "Each weather rule's figures and boundaries, written down from 14 CFR 1.1 and 91.175(h), the AIM and the Aviation Weather Handbook, never from the code. Shape and checks as engine/facade/tests/common/cases.rs says; asked by engine/facade/tests/rule_cases.rs.",
  "cases": [
    {
      "name": "FEW008 SCT012 BKN025 OVC018: the ceiling is 1,800, the lowest broken or overcast",
      "rule": "ceiling_visibility",
      "input": {
        "layers": [
          {
            "cover": "FEW",
            "base_ft": 800
          },
          {
            "cover": "SCT",
            "base_ft": 1200
          },
          {
            "cover": "BKN",
            "base_ft": 2500
          },
          {
            "cover": "OVC",
            "base_ft": 1800
          }
        ]
      },
      "expect": [
        {
          "path": "ceiling_ft",
          "value": 1800,
          "tolerance": 0
        }
      ],
      "source": "14 CFR 1.1: \"Ceiling means the height above the earth's surface of the lowest layer of clouds or obscuring phenomena that is reported as 'broken', 'overcast', or 'obscuration', and not classified as 'thin' or 'partial'.\""
    },
    {
      "name": "Scattered only: no ceiling",
      "rule": "ceiling_visibility",
      "input": {
        "layers": [
          {
            "cover": "SCT",
            "base_ft": 900
          }
        ]
      },
      "expect": [
        {
          "path": "ceiling_ft",
          "equals": null
        }
      ],
      "source": "14 CFR 1.1: \"Ceiling means the height above the earth's surface of the lowest layer of clouds or obscuring phenomena that is reported as 'broken', 'overcast', or 'obscuration', and not classified as 'thin' or 'partial'.\""
    },
    {
      "name": "An obscuration, VV003, under an overcast at 1,000: the ceiling is 300",
      "rule": "ceiling_visibility",
      "input": {
        "layers": [
          {
            "cover": "OVC",
            "base_ft": 1000
          }
        ],
        "vertical_visibility_ft": 300
      },
      "expect": [
        {
          "path": "ceiling_ft",
