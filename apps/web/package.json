{
  "name": "wingtip-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "types": "openapi-typescript ../../services/planner/openapi.json -o src/lib/api/schema.d.ts && openapi-typescript ../../services/assistant/openapi.json -o src/lib/api/assistant-schema.d.ts && openapi-typescript ../../services/gateway/openapi.json -o src/lib/api/gateway-schema.d.ts && json2ts -i ../../engine/contract/engine.schema.json -o src/lib/engine/contract.ts --no-additionalProperties --unreachableDefinitions --bannerComment \"/* Generated by json-schema-to-typescript from engine/contract/engine.schema.json (npm run types): change the schema, not this file. */\"",
    "predev": "npm run types",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run types",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "pretest": "npm run types",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "pretypecheck": "npm run types",
    "typecheck": "tsc --noEmit",
    "prelint": "npm run types",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write --log-level warn . ../../scripts/build/*.mjs",
    "format:check": "prettier --check --log-level warn . ../../scripts/build/*.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@deck.gl/core": "9.4.1",
    "@deck.gl/extensions": "9.4.1",
    "@deck.gl/layers": "9.4.1",
    "@deck.gl/maplibre": "9.4.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@hookform/resolvers": "^7.0.5",
    "@huggingface/transformers": "^4.3.2",
    "@internationalized/date": "^3.12.4",
    "@luma.gl/core": "9.4.2",
    "@luma.gl/engine": "9.4.2",
    "@react-aria/live-announcer": "^3.5.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-table": "^9.3.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@wavesurfer/react": "^1.0.14",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "embla-carousel-react": "^8.6.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.70.0",
    "maplibre-gl": "6.17.0",
    "mediabunny": "^1.65.2",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "pmtiles": "^4.5.0",
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.1",
    "recharts": "^3.10.1",
    "shadcn": "^4.23.0",
    "spatial-navigation-polyfill": "^1.3.1",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "wavesurfer.js": "^8.1.0",
    "weatherlayers-gl": "2026.9.1",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "^8.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/culori": "^4.0.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/eslint-plugin": "1.6.28",
    "babel-plugin-react-compiler": "^1.0.0",
    "culori": "^4.0.2",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-testing-library": "7.16.2",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "json-schema-to-typescript": "16.0.0",
    "knip": "6.44.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    },
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "@ts-morph/common": {
      "minimatch": "11.0.6"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.6"
    },
    "eslint": {
      "minimatch": "11.0.6"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.6"
    },
    "eslint-plugin-jsx-a11y-x": {
      "minimatch": "11.0.6"
    },
    "workbox-build": {
      "glob": "^14.0.4"
    }
  },
  "allowScripts": {
    "@scarf/scarf": false,
    "tesseract.js": false
  }
}
