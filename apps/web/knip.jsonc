// knip: no unused file, export, type or dependency in the web app
// (`npx knip`, scripts/dev/check.sh's web area and CI's test-web).
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Run by Playwright and CI by name, not imported.
  "entry": ["e2e/auth.setup.ts", "playwright.rehearsal.config.ts", "scripts/*.mjs"],
  // Generated by scripts/build/design-tokens.sh for every app alike.
  "ignore": ["src/lib/tokens.ts"],
  // Copied into the build by vite.config.ts's tesseract-files, by path.
  "ignoreDependencies": ["@tesseract.js-data/eng"],
  "ignoreIssues": {
    // The stock shadcn/ui files, kept whole as the CLI writes them.
    "src/components/ui/**": ["exports", "types"],
    // Loaded whole with import() and drawn by name (TrainWorkspace's
    // dev chunk), which knip does not follow.
    "src/features/chart-labels/dev/DevPanel.tsx": ["exports"],
    // BootMap, the same: routeMapChunk loads RouteMap.tsx with import()
    // and reads it off the module (m.BootMap), which knip 6 no longer
    // follows to GlRouteMap's GlBootMap.
    "src/features/plan/components/RouteMap.tsx": ["exports"],
    "src/features/plan/map/GlRouteMap.tsx": ["exports"],
    // levelOf, heldTrack and choose: its tests import it afresh with
    // import() for each case and reach them on the module.
    "src/lib/audioInput.ts": ["exports"],
  },
  "ignoreExportsUsedInFile": false,
  "rules": { "duplicates": "off" },
}
