<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of the app's is backed up to the cloud or carried to a new
     phone (Android 12 and up; allowBackup="false" below that): the
     session's cookies are the app's own (CookieStore), and the pilot's
     records are kept by the gateway, signed in again on the new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
