<?xml version="1.0" encoding="utf-8"?>
<!-- The Next Flight widget (widget/NextFlightWidget.kt): two cells square
     to start, down to two by one (the route and its figures alone), wider
     for the departure time and the nav log's button. The
     app redraws it as the plan changes (NextFlightFeed), so the launcher
     never asks on a clock. Android 12's picker words and cell sizes are
     in xml-v31. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:updatePeriodMillis="0" />
