<?xml version="1.0" encoding="utf-8"?>
<!-- The adaptive launcher icon (Android 8.0+): the brand's own layers,
     docs/brand/android-background.svg (the piece of sectional) behind and
     android-foreground.svg (the mark) in front, masked by each launcher to
     its own shape; android-monochrome.svg for the themed icons of Android
     13 and later. Drawn to PNG per density by scripts/build/app-icons.sh,
     since a vector drawable's stroke has no dashes for the ring. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
