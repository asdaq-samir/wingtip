<?xml version="1.0" encoding="utf-8"?>
<!-- The window's theme on Android 12 and later, which draws every app's
     launch as a splash screen (the SplashScreen API): the brand's ground
     (design/tokens.json color.brand.launch, launch-night) with the mark in
     the middle (docs/brand/mark.svg, 288 dp with the ring inside the
     192 dp circle the system keeps), both from
     scripts/build/app-icons.sh. The rest as values/themes.xml. -->
<resources>
    <style name="Theme.WingtipMaps" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
    </style>
</resources>
