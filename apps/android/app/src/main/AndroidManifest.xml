<?xml version="1.0" encoding="utf-8"?>
<!-- The native Android app (docs/NATIVE-ANDROID.md). The network for the
     planner, the gateway and the chart's tiles; whether there is one, for
     the words shown when there is not; and the position own ship reads. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Own ship (flight/OwnShip.kt): the position at one fix a second,
         kept with the screen off while flying through a foreground
         service of the location type (Android 14 wants the typed
         permission too), with the notification Android requires for one
         and the alerts the flight pieces post (notify/Notifications.kt).
         Precise and approximate both: Android 12 and later ignore a
         request for precise location alone, and let the pilot pick
         approximate, which own ship then says is not enough to fly by. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16's Live Updates (notify/LiveFlight.kt): own ship's
         notification promoted to the status bar's chip and the top of the
         shade while flying a route, as the iPhone's Live Activity is. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- The microphone, with the pilot's leave, asked the moment it is
         needed: a question said to the search (voice/VoiceInput) and the
         parked ATC copilot (atc/), the radio listened to through the
         phone's speech recognizer while flying.
         The ATC copilot and the cockpit receiver are parked (Settings'
         Extras, off to start; docs/store/feature-review.md) and out of
         the first store build: no foreground service of the microphone
         type (FOREGROUND_SERVICE_MICROPHONE and atc/AtcListenService) nor
         of the connected-device type (FOREGROUND_SERVICE_CONNECTED_DEVICE
         and receiver/ReceiverService) is declared, so Play asks no
         declaration or video for either. Turned on in this build, each
         works while the app is in front. Bring both back, permission and
         service, with the feature. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- A cockpit ADS-B receiver's GDL 90 on the Wi-Fi (receiver/, parked):
         the multicast lock lets the datagrams sent to the network's
         broadcast address through. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Android 11 and later show an app only the services it names: the
         phone's speech recognizer, which the ATC copilot listens through. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- Only HTTPS: the gateway and the tiles' CDN are, and a plain-HTTP
         request is refused by the system rather than sent. The session's
         cookies are kept by the app itself (CookieStore), so Android's
         backup of the app's data is off (allowBackup and backup_rules below
         Android 12, data_extraction_rules from it on). Predictive back (Android 14+):
         the system's back animation, with nothing of our own in its way. -->
    <application
        android:name=".WingtipApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.WingtipMaps"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33">

        <!-- One task, one instance: a link tapped in Gmail while the app is
             open comes to the running activity as a new intent
             (MainActivity.onNewIntent) rather than opening a second one.
             A resize, a rotation, a fold or a desktop window dragged wider
             is Compose's to lay out again (configChanges), not a new
             activity: the map keeps its tiles, camera and layers rather
             than loading again at each step of a drag, and the screen's
             state is kept as it is (Android's Tier 3 Config_Changes; the
             app has no size-qualified resources to reload). So is the
             night turning (uiMode): Appearance picked in the app
             (setApplicationNightMode) or the phone's dark changing redraws
             Compose in the new theme, not a restarted activity that drops
             the map and the open card. -->
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.WingtipMaps.Starting"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- App Links (docs/NATIVE-ANDROID.md): the sign-in link emailed to the
                 pilot, and a shared route, open the app rather than Chrome,
                 verified against the site's /.well-known/assetlinks.json
                 once the owner lists this package's signing key there. The
                 host is the build's WINGTIP_HOST (build.gradle.kts). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="${wingtipHost}" />
                <data android:pathPrefix="/app/plan" />
                <data android:pathPrefix="/api/auth/magic-link/verify" />
            </intent-filter>
            <!-- The app's own scheme, wingtipmaps://plan?open=<screen>, for a
                 shortcut or another app to open a screen (design/screens.json,
                 Links); the site's address above opens the same screens. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="wingtipmaps" android:host="plan" />
            </intent-filter>
            <!-- A PDF shared from another app, or opened with Wingtip from
                 Files or a mail, kept among the pilot's own documents on
                 this phone and opened in the reader (library/OwnShelf;
                 decision 0056). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <!-- A route from another app's flight-plan file, Garmin's .fpl or a
                 GPX, opened with Wingtip or shared to it: read by the engine
                 (route_file_read) and previewed as a shared flight is,
                 never planned unasked (share/FlightFiles). An .fpl has no
                 type of its own: Files and mail hand it over as XML. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
            </intent-filter>
            <!-- The app's shortcuts and App Actions' OPEN_APP_FEATURE, one
                 per screen (res/xml/shortcuts.xml, generated from
                 design/screens.json; docs/android-ai.md). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- A plate in a window of its own beside the map, on a tablet, a
             foldable or a desktop window (plates/PlateWindow): a task each,
             resizable, laid out again by Compose as the window changes. No
             intent filter: links and files go to MainActivity alone. -->
        <activity
            android:name=".plates.PlateWindowActivity"
            android:theme="@style/Theme.WingtipMaps"
            android:exported="false"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />

        <!-- The app's actions and entities for Gemini and the system's
             agents (AppFunctions, Android 16 and later; ai/functions/):
             the service the AppFunctions compiler writes from
             WingtipFunctions, bound only by the system
             (BIND_APP_FUNCTION_SERVICE), with the schema it indexes. -->
        <service
            android:name=".ai.functions.WingtipFunctionService"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE"
            android:exported="true"
            tools:targetApi="36">
            <property
                android:name="android.app.appfunctions.schema"
                android:value="app_functions_schema.xsd" />
            <property
                android:name="android.app.appfunctions.v2"
                android:value="wingtip_functions.xml" />
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
            </intent-filter>
        </service>
        <!-- What the agents are told of the functions together, and what
             the pilot is shown they let an agent do. -->
        <property
            android:name="android.app.appfunctions.app_metadata"
            android:resource="@xml/app_functions_metadata" />
        <!-- The foreground service that keeps the fixes coming with the
             screen off while the airplane is flying (flight/OwnShip.kt);
             started only by the pilot's Start Flight at flying speed
             (flight/StartFlightAsk.kt) and stopped as the airplane slows
             below it, never by itself or anything outside the app. -->
        <service
            android:name=".flight.OwnShipService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- The home screen's Next Flight widget (widget/NextFlightWidget.kt),
             a Glance widget; the launcher talks to its receiver. -->
        <receiver
            android:name=".widget.NextFlightReceiver"
            android:exported="true"
            android:label="@string/widget_next_flight">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_flight_widget_info" />
        </receiver>
    </application>

</manifest>
