#!/usr/bin/env bash
# The quick checks, before a push, for the parts of the repo the push
# changes against the branch it builds on (main, or the wave's
# claude/integration where it was cut from that): TypeScript and ESLint for
# apps/web/, `cargo check` for engine/, each changed language's formatter
# (scripts/dev/format.sh --check), and then, by default, scripts/dev/preflight.sh:
# what the pull request's tier 1 will run for this change, narrowly -- the
# guards' repo leg, the generated files, the WebAssembly's budget, the
# change's own unit tests and the reached specs' pass. A type error, a lint
# failure or a ratchet then stops on the Mac in a minute or two rather than
# in CI minutes later (the owner, 2026-11-06: development faster; 2026-11-21:
# "a smarter CI so it passes on first push"). Each Docker run in it takes a
# turn of scripts/dev/one-at-a-time.sh.
#
# Installed by scripts/dev/install-hooks.sh. Skipped with `git push
# --no-verify` or SKIP_HOOKS=1. A check whose tool is not on this machine
# is skipped with a note rather than failing the push. The web's are the
# exception where Docker runs: without node here, Prettier and ESLint run on
# the web files the push changes, in scripts/dev/check.sh's image (seconds).
# PRE_PUSH_WEB_DOCKER=0 leaves them to CI for a push; =1 adds tsc and the
# layers over the whole project, in the same image.
set -uo pipefail

if [ -n "${SKIP_HOOKS:-}" ]; then
  echo "pre-push: skipped (SKIP_HOOKS)"
  exit 0
fi

repo=$(git rev-parse --show-toplevel)
here=$repo
PATH=$PATH:$HOME/.docker/bin:/Applications/Docker.app/Contents/Resources/bin:$HOME/.local/bin:$HOME/.cargo/bin
zero=0000000000000000000000000000000000000000

# Where a pushed commit left the branch it builds on: main, or the wave's
# branch when that is the nearer of the two. A push is judged by what it
# adds. Held against main alone, a branch cut from claude/integration
# answered for the whole wave: on 2026-11-15 a clean checkout of the wave's
# head was refused for another branch's SwiftLint finding, which no pusher
# could put right, and about 200 of the 510 pushes to the wave's branch in
# the four days before had skipped this hook (decision 0044). The wave
# against main is CI's to judge, on its pull request.
base_of() {
  local main wave
  main=$(git merge-base origin/main "$1" 2>/dev/null) || main=""
  wave=$(git merge-base origin/claude/integration "$1" 2>/dev/null) || wave=""
  if [ -n "$wave" ] && { [ -z "$main" ] || git merge-base --is-ancestor "$main" "$wave"; }; then
    echo "$wave"
  else
    echo "$main"
  fi
}

# The files the pushed commits change against that base (from where they
# left it), for each ref pushed. A deleted ref changes nothing.
refs=$(cat)
changed=$(
  while read -r _local_ref local_sha _remote_ref _remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    base=$(base_of "$local_sha")
    [ -n "$base" ] || continue
    git diff --name-only --diff-filter=d "$base" "$local_sha"
  done <<<"$refs" | sort -u
)
# A path with anything but plain characters (a space, `;`, `$`, a backtick, a
# quote, a leading `-`) is left out and named: file names reach the tools
# below as arguments, never through a shell string, but a branch from
# another contributor can carry any name, so the odd ones are not checked
# here (CI checks them) rather than trusted.
safe='^[A-Za-z0-9._@+/][A-Za-z0-9._@+/-]*$'
odd=$(grep -vE "$safe" <<<"$changed" || true)
if [ -n "$odd" ]; then
  echo "pre-push: not checked here, odd file name(s): $(tr '\n' ' ' <<<"$odd" | cut -c1-200)"
  changed=$(grep -E "$safe" <<<"$changed" || true)
fi
if [ -z "$changed" ]; then exit 0; fi

# The commit pushed (the last of the refs, for a push of several), since the
# checks must read it and not whatever this checkout holds: a push from the
# main checkout of another branch's commit (`git push origin
# origin/claude/x:refs/heads/claude/y`) made ruff report E902 "No such file"
# for every file only the pushed commit has (2026-11-08). When the checkout
# is not on that commit, or has uncommitted changes to tracked files, the
# commit is checked out detached into a temporary worktree, removed on exit.
pushed=$(printf '%s\n' "$refs" | awk -v z="$zero" '$2 != z { sha = $2 } END { print sha }')
# What the guards below hold that commit against (their --base).
judged=$(base_of "${pushed:-HEAD}")
judged=${judged:-origin/main}
tmp=""
# shellcheck disable=SC2329  # run by the EXIT trap below
cleanup() {
  if [ -n "$tmp" ]; then
    git -C "$repo" worktree remove --force "$tmp" >/dev/null 2>&1 || rm -rf "$tmp"
    git -C "$repo" worktree prune
  fi
}
trap cleanup EXIT
note_tree=""
if [ -n "$pushed" ] && { [ "$(git -C "$repo" rev-parse HEAD)" != "$pushed" ] || [ -n "$(git -C "$repo" status --porcelain --untracked-files=no)" ]; }; then
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/wingtip-pre-push.XXXXXX")
  if git -C "$repo" worktree add -q --detach "$tmp" "$pushed" >/dev/null 2>&1; then
    here=$tmp
    # Packages are installed once, in the checkout; the pushed tree reads them.
    if [ -d "$repo/apps/web/node_modules" ]; then ln -s "$repo/apps/web/node_modules" "$tmp/apps/web/node_modules"; fi
    note_tree="pushed commit ${pushed:0:9}, in a temporary worktree"
  else
    echo "pre-push: could not check out ${pushed:0:9}; checking this working tree instead"
    rm -rf "$tmp"
    tmp=""
  fi
fi

failed=0
note() { echo "pre-push: $*"; }
fail() { echo "pre-push: $* failed"; failed=1; }
if [ -n "$note_tree" ]; then note "checking the $note_tree"; fi

# Which parts the push touches is scripts/areas.yml's (the table check.sh and
# CI's changes filter read too), from the pushed tree's own copy. The quick
# checks below are the web's and the engine's; ruff goes by .py files.
if command -v python3 >/dev/null; then
  areas=$(python3 "$here/scripts/areas.py" areas <<<"$changed") || { note "areas.yml unreadable, no quick check run"; areas=""; }
else
  note "no python3 here: the web and engine checks are left to CI"
  areas=""
fi
has_area() { grep -qx "$1" <<<"$areas"; }

# --- web: tsc over the project, ESLint over the files changed ---------------
web_files=$(grep -E '^apps/web/.*\.(ts|tsx|js|jsx|mjs|cjs)$' <<<"$changed" | grep -v '^apps/web/src/lib/engine/pkg/' || true)
# Node on this machine, with the web's packages: its checks run here.
web_host=""
if command -v npx >/dev/null && [ -d "$here/apps/web/node_modules" ]; then web_host=1; fi

# Without it, scripts/dev/check.sh's image, with the web's packages installed
# for the pushed tree's lock, looked for once a push. Where no check has
# built that one, the newest there is: a lock a commit or two older lints
# and formats the same nearly always, and an image kept for every lock
# filled the disk (check-images.sh's prune_tags). With none at all it is
# built here, once, the way check-images.sh builds it, and both share it
# from then on.
# $web_tag is left empty, with a note, where there is no image to run in.
web_image() {
  [ -z "${web_tag+set}" ] || return 0
  web_tag=""
  if [ "${PRE_PUSH_WEB_DOCKER:-}" = 0 ]; then
    note "web: Prettier and ESLint left to CI (no node here, and PRE_PUSH_WEB_DOCKER=0)"
  elif ! command -v docker >/dev/null || ! docker info >/dev/null 2>&1; then
    note "web: skipped, neither node nor Docker is running here"
  else
    local node tag newest ctx
    node=$("$here/scripts/build/toolchain.sh" get nodejs)
    tag=wingtip-check-web:$({ echo "node $node"; cat "$here/apps/web/package.json" "$here/apps/web/package-lock.json"; } | shasum -a 256 | cut -c1-16)
    if ! docker image inspect "$tag" >/dev/null 2>&1; then
      newest=$(docker image ls wingtip-check-web --format '{{.CreatedAt}}|{{.Repository}}:{{.Tag}}' | sort -r | head -1 | cut -d'|' -f2)
      if [ -n "$newest" ]; then
        note "web: no image for this lock, so the newest one, another lock's (scripts/dev/check.sh web builds this one's)"
        tag=$newest
      else
        note "web: building $tag once (npm ci, a minute or two)"
        ctx=$(mktemp -d)
        cp "$here/apps/web/package.json" "$here/apps/web/package-lock.json" "$ctx/"
        docker build -q -t "$tag" --build-arg NODE="$node" -f - "$ctx" >/dev/null <<'EOF' || tag=""
ARG NODE
FROM node:${NODE}-slim
COPY package.json package-lock.json /
RUN --mount=type=cache,id=wingtip-npm,target=/root/.npm \
    cd / && npm ci --no-audit --no-fund --loglevel=error
ENV PATH=/node_modules/.bin:$PATH
EOF
        rm -rf "$ctx"
      fi
    fi
    if [ -n "$tag" ]; then web_tag=$tag; else note "web: skipped, the wingtip-check-web image would not build"; fi
  fi
}
# web_docker <what it runs> <script> [file...]: the script in that image, in
# the pushed tree's apps/web, with the files as its arguments ("$@", never
# text in it). With no image nothing runs, and that is no failure.
web_docker() {
  local what=$1 script=$2 hide=()
  shift 2
  web_image
  [ -n "$web_tag" ] || return 0
  note "web: $what in $web_tag"
  # A checkout's own node_modules (macOS binaries) is hidden from the image's.
  [ -d "$here/apps/web/node_modules" ] && hide=(--tmpfs /repo/apps/web/node_modules)
  docker run --rm -e NPM_CONFIG_UPDATE_NOTIFIER=false -v "$here:/repo" "${hide[@]+"${hide[@]}"}" -w /repo/apps/web "$web_tag" sh -c "$script" sh "$@"
}

if has_area web; then
  lint=()
  while IFS= read -r f; do [ -n "$f" ] && lint+=("${f#apps/web/}"); done <<<"$web_files"
  # The API and engine types are generated, not committed: tsc needs them.
  # The files are the script's own arguments ("$@"), after `--`, not text.
  # And the feature layers (dependency-cruiser, .dependency-cruiser.cjs).
  web_cmd='npm run -s types >/dev/null && npx tsc --noEmit && { [ "$#" -eq 0 ] || npx eslint --max-warnings 0 --no-warn-ignored -- "$@"; } && npm run -s layers'
  if [ -n "$web_host" ]; then
    note "web: tsc${lint[0]:+, eslint}"
    (cd "$here/apps/web" && sh -c "$web_cmd" sh "${lint[@]+"${lint[@]}"}") || fail "web"
  elif [ "${PRE_PUSH_WEB_DOCKER:-0}" != 0 ]; then
    web_docker "tsc${lint[0]:+, eslint}" "$web_cmd" "${lint[@]+"${lint[@]}"}" || fail "web"
  else
    # In Docker the whole check took about 12 minutes on a loaded Mac
    # (2026-11-07), and the owner wants no check to hold up a push: tsc and
    # the layers, which read the whole project, are CI's unless
    # PRE_PUSH_WEB_DOCKER=1 asks. ESLint on the files changed is seconds, so
    # it runs (the owner, 2026-11-15), after the types `npm run lint`
    # generates first, though its config reads none of them today.
    note "web: tsc and the layers left to CI (no node here; PRE_PUSH_WEB_DOCKER=1 runs them in Docker)"
    if [ ${#lint[@]} -gt 0 ]; then
      web_docker "eslint on ${#lint[@]} file(s)" 'npm run -s types >/dev/null && eslint --max-warnings 0 --no-warn-ignored --no-error-on-unmatched-pattern -- "$@"' "${lint[@]}" || fail "web: eslint"
    fi
  fi
fi

# --- engine: cargo check over the crates CI tests ---------------------------
if has_area engine; then
  if command -v cargo >/dev/null && cargo --version >/dev/null 2>&1; then
    # CI's own crate list (scripts/ci/engine_affected.py --all), so this checks what CI tests;
    # a target directory per worktree, keyed by its path. One shared by every
    # worktree failed falsely: Cargo took another worktree's newer build of a
    # crate of ours, at another path, for this one's (2026-11-08).
    read -ra pkgs <<<"$(python3 "$here/scripts/ci/engine_affected.py" --all)"
    note "engine: cargo check"
    # The directories of worktrees not pushed from in two weeks go (a cold
    # check at worst).
    find "$HOME/Library/Caches/wingtip-pre-push-cargo" -mindepth 1 -maxdepth 1 -type d -mtime +14 -exec rm -rf {} + 2>/dev/null || true
    # Keyed by the lock's hash as well: the same path with another lock gave
    # a false "cannot find `performance` in `wingtip_flight`" while a clean
    # target passed (2026-11-08), so a failure is tried once more on a clean
    # target, and only that second result counts.
    lockkey=$(shasum -a 256 "$here/engine/Cargo.lock" 2>/dev/null | cut -c1-8)
    target=${WINGTIP_HOOK_CARGO_TARGET:-$HOME/Library/Caches/wingtip-pre-push-cargo/$(basename "$repo")-$(printf '%s' "$repo" | shasum -a 256 | cut -c1-8)-${lockkey:-nolock}}
    mkdir -p "$target" && printf '%s\n' "$repo" > "$target/.worktree"   # for tidy-local.sh
    if ! CARGO_TARGET_DIR=$target cargo check -q --manifest-path "$here/engine/Cargo.toml" "${pkgs[@]}"; then
      note "engine: cargo check failed; once more on a clean target"
      rm -rf "$target"
      CARGO_TARGET_DIR=$target cargo check -q --manifest-path "$here/engine/Cargo.toml" "${pkgs[@]}" || fail "cargo check"
    fi
  else
    note "engine: skipped, no Rust toolchain here (CI checks it)"
  fi
fi

# --- the formatters, for the languages the push changes ----------------------
# scripts/dev/format.sh --check, each language's tool at its pinned version,
# over that language's whole tree (seconds each). format.sh runs nothing in
# Docker here: the Java without mvn is left to CI. Prettier without node on
# this machine runs in the web's image, on the files the push changes: four
# files Prettier would have refused reached CI in the wave of 12-15 November
# 2026, each at the cost of a run, because this Mac has no node. A change to
# Prettier's settings checks every file, as format.sh does.
fmt=()
pretty=$(grep -E '^(apps/web/.*\.(ts|tsx|js|jsx|mjs|cjs|css|json|jsonc|md)|scripts/build/.*\.mjs|\.prettierrc\.yaml)$' <<<"$changed" || true)
if [ -n "$pretty" ] && [ -n "$web_host" ]; then
  fmt+=(web)
elif [ -n "$pretty" ]; then
  # Paths as Prettier takes them from apps/web, where its ignore file is.
  files=(. '../../scripts/build/*.mjs')
  what="prettier on every file (its settings changed)"
  if ! grep -qxF .prettierrc.yaml <<<"$pretty"; then
    files=()
    while IFS= read -r f; do
      case $f in apps/web/*) files+=("${f#apps/web/}") ;; *) files+=("../../$f") ;; esac
    done <<<"$pretty"
    what="prettier on ${#files[@]} file(s)"
  fi
  web_docker "$what" 'prettier --check --log-level warn --no-error-on-unmatched-pattern -- "$@"' "${files[@]}" \
    || fail "format (scripts/dev/format.sh web formats them)"
fi
grep -qE '(\.py$|^\.ruff\.toml$)' <<<"$changed" && fmt+=(python)
grep -qE '^engine/.*(\.rs|rustfmt\.toml)$' <<<"$changed" && fmt+=(rust)
grep -qE '^apps/ios/(.*\.swift|\.swiftformat)$' <<<"$changed" && fmt+=(swift)
grep -qE '(^apps/android/.*\.kts?$|^\.editorconfig$)' <<<"$changed" && fmt+=(kotlin)
grep -qE '^services/gateway/(.*\.java|pom\.xml)$' <<<"$changed" && fmt+=(java)
if [ ${#fmt[@]} -gt 0 ]; then
  note "format: ${fmt[*]}"
  "$here/scripts/dev/format.sh" --check --no-docker "${fmt[@]}"
  case $? in
    0) ;;
    2) note "format: a language above was skipped (its tool is not here; CI checks it)" ;;
    *) fail "format (scripts/dev/format.sh ${fmt[*]} formats them)" ;;
  esac
fi

# --- preflight: what the pull request's tier 1 runs, narrowly (the default) --
# scripts/dev/preflight.sh asks CI's own scripts what tier 1 will run for
# this change (areas.py, plan.py, browser_specs.py) and runs it here: the
# guards' repo leg (ruff, the ratchet, the file sizes, the tokens, the
# workflows, the phones' lint ...), the generated files (regen-all.sh
# --check), the WebAssembly's budget, the change's own unit tests and the
# reached specs' pass (decision 0048). On 2026-11-21 PR #589 went red on
# the simplicity ratchet, which this hook ran only for a source file's
# change; it is CI's whole leg now. PRE_PUSH_TESTS=0 leaves the unit tests
# to CI; a push to the wave's branch answers for its specs on its pull
# request.
if command -v python3 >/dev/null; then
  pre=()
  [ "${PRE_PUSH_TESTS:-1}" != 0 ] || pre+=(--no-tests)
  specs=1 against=$judged
  # The wave's own branch is judged as its pull request is, against main:
  # against itself it changed nothing, and PR #589's ratchet (RootView, 183
  # of 175) came in by its merges, which no branch's push had added.
  if grep -q ' refs/heads/claude/integration ' <<<"$refs"; then
    specs=0
    against=$(git merge-base origin/main "${pushed:-HEAD}" 2>/dev/null || echo "$judged")
  fi
  (cd "$here" && PREFLIGHT_SPECS=$specs PREFLIGHT_STAMP="$(git -C "$repo" rev-parse --absolute-git-dir)/branch-specs-passed" \
    scripts/dev/preflight.sh --base "$against" "${pre[@]+"${pre[@]}"}") || fail "preflight (scripts/dev/preflight.sh)"
else
  note "preflight: left to CI (no python3 here)"
fi
if [ "$failed" -ne 0 ]; then
  echo "pre-push: fix the above; what this refuses, CI's guards refuse minutes later. If the hook itself is broken, SKIP_HOOKS=1 and say so in the push's report (decision 0044)"
  exit 1
fi
exit 0
