#!/usr/bin/env bash
# The quick checks, before a push, for the parts of the repo the push
# changes against origin/main: TypeScript and ESLint for apps/web/, ruff for
# the Python, `cargo check` for engine/, and each changed language's
# formatter (scripts/dev/format.sh --check). A type error or a lint failure
# then stops on the Mac in seconds rather than in CI minutes later (the
# owner, 2026-11-06: development faster). The full checks -- the tests --
# stay with scripts/dev/one-at-a-time.sh and CI; this runs outside the lock,
# since it is quick and holds no turn.
#
# Installed by scripts/dev/install-hooks.sh. Skipped with `git push
# --no-verify` or SKIP_HOOKS=1. A check whose tool is not on this machine
# is skipped with a note rather than failing the push.
set -uo pipefail

if [ -n "${SKIP_HOOKS:-}" ]; then
  echo "pre-push: skipped (SKIP_HOOKS)"
  exit 0
fi

repo=$(git rev-parse --show-toplevel)
here=$repo
PATH=$PATH:$HOME/.docker/bin:/Applications/Docker.app/Contents/Resources/bin:$HOME/.local/bin:$HOME/.cargo/bin
zero=0000000000000000000000000000000000000000

# The files the pushed commits change against origin/main (from where they
# left it), for each ref pushed. A deleted ref changes nothing.
refs=$(cat)
changed=$(
  while read -r _local_ref local_sha _remote_ref _remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    base=$(git merge-base origin/main "$local_sha" 2>/dev/null) || continue
    git diff --name-only --diff-filter=d "$base" "$local_sha"
  done <<<"$refs" | sort -u
)
# A path with anything but plain characters (a space, `;`, `$`, a backtick, a
# quote, a leading `-`) is left out and named: file names reach the tools
# below as arguments, never through a shell string, but a branch from
# another contributor can carry any name, so the odd ones are not checked
# here (CI checks them) rather than trusted.
safe='^[A-Za-z0-9._@+/][A-Za-z0-9._@+/-]*$'
odd=$(grep -vE "$safe" <<<"$changed" || true)
if [ -n "$odd" ]; then
  echo "pre-push: not checked here, odd file name(s): $(tr '\n' ' ' <<<"$odd" | cut -c1-200)"
  changed=$(grep -E "$safe" <<<"$changed" || true)
fi
if [ -z "$changed" ]; then exit 0; fi

# The commit pushed (the last of the refs, for a push of several), since the
# checks must read it and not whatever this checkout holds: a push from the
# main checkout of another branch's commit (`git push origin
# origin/claude/x:refs/heads/claude/y`) made ruff report E902 "No such file"
# for every file only the pushed commit has (2026-11-08). When the checkout
# is not on that commit, or has uncommitted changes to tracked files, the
# commit is checked out detached into a temporary worktree, removed on exit.
pushed=$(printf '%s\n' "$refs" | awk -v z="$zero" '$2 != z { sha = $2 } END { print sha }')
tmp=""
cleanup() {
  if [ -n "$tmp" ]; then
    git -C "$repo" worktree remove --force "$tmp" >/dev/null 2>&1 || rm -rf "$tmp"
    git -C "$repo" worktree prune
  fi
}
trap cleanup EXIT
note_tree=""
if [ -n "$pushed" ] && { [ "$(git -C "$repo" rev-parse HEAD)" != "$pushed" ] || [ -n "$(git -C "$repo" status --porcelain --untracked-files=no)" ]; }; then
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/wingtip-pre-push.XXXXXX")
  if git -C "$repo" worktree add -q --detach "$tmp" "$pushed" >/dev/null 2>&1; then
    here=$tmp
    # Packages are installed once, in the checkout; the pushed tree reads them.
    if [ -d "$repo/apps/web/node_modules" ]; then ln -s "$repo/apps/web/node_modules" "$tmp/apps/web/node_modules"; fi
    note_tree="pushed commit ${pushed:0:9}, in a temporary worktree"
  else
    echo "pre-push: could not check out ${pushed:0:9}; checking this working tree instead"
    rm -rf "$tmp"
    tmp=""
  fi
fi

failed=0
note() { echo "pre-push: $*"; }
fail() { echo "pre-push: $* failed"; failed=1; }
if [ -n "$note_tree" ]; then note "checking the $note_tree"; fi

# Which parts the push touches is scripts/areas.yml's (the table check.sh and
# CI's changes filter read too), from the pushed tree's own copy. The quick
# checks below are the web's and the engine's; ruff goes by .py files.
if command -v python3 >/dev/null; then
  areas=$(python3 "$here/scripts/areas.py" areas <<<"$changed") || { note "areas.yml unreadable, no quick check run"; areas=""; }
else
  note "no python3 here: the web and engine checks are left to CI"
  areas=""
fi
has_area() { grep -qx "$1" <<<"$areas"; }

# --- web: tsc over the project, ESLint over the files changed ---------------
web_files=$(grep -E '^apps/web/.*\.(ts|tsx|js|jsx|mjs|cjs)$' <<<"$changed" | grep -v '^apps/web/src/lib/engine/pkg/' || true)
if has_area web; then
  lint=()
  while IFS= read -r f; do [ -n "$f" ] && lint+=("${f#apps/web/}"); done <<<"$web_files"
  # The API and engine types are generated, not committed: tsc needs them.
  # The files are the script's own arguments ("$@"), after `--`, not text.
  web_cmd='npm run -s types >/dev/null && npx tsc --noEmit && { [ "$#" -eq 0 ] || npx eslint --max-warnings 0 --no-warn-ignored -- "$@"; }'
  if command -v npx >/dev/null && [ -d "$here/apps/web/node_modules" ]; then
    note "web: tsc${lint[0]:+, eslint}"
    (cd "$here/apps/web" && sh -c "$web_cmd" sh "${lint[@]+"${lint[@]}"}") || fail "web"
  elif [ -z "${PRE_PUSH_WEB_DOCKER:-}" ]; then
    # In Docker the web check took about 12 minutes on a loaded Mac
    # (2026-11-07), and the owner wants no check to hold up a push: without
    # node on the host it is left to CI unless PRE_PUSH_WEB_DOCKER=1 asks.
    note "web: left to CI (no node here; PRE_PUSH_WEB_DOCKER=1 runs it in Docker)"
  elif command -v docker >/dev/null && docker info >/dev/null 2>&1; then
    # scripts/dev/check.sh's image, with web's packages installed for this lock,
    # if a check has built it; the newest one otherwise (a lock a commit or
    # two older types the same nearly always); else it is built here, once,
    # the way check.sh builds it, and both share it from then on.
    node=$("$here/scripts/build/toolchain.sh" get nodejs)
    tag=wingtip-check-web:$({ echo "node $node"; cat "$here/apps/web/package.json" "$here/apps/web/package-lock.json"; } | shasum -a 256 | cut -c1-16)
    if ! docker image inspect "$tag" >/dev/null 2>&1; then
      newest=$(docker image ls wingtip-check-web --format '{{.CreatedAt}}|{{.Repository}}:{{.Tag}}' | sort -r | head -1 | cut -d'|' -f2)
      if [ -n "$newest" ]; then
        tag=$newest
      else
        note "web: building $tag once (npm ci, a minute or two)"
        ctx=$(mktemp -d)
        cp "$here/apps/web/package.json" "$here/apps/web/package-lock.json" "$ctx/"
        docker build -q -t "$tag" --build-arg NODE="$node" -f - "$ctx" >/dev/null <<'EOF' || tag=""
ARG NODE
FROM node:${NODE}-slim
COPY package.json package-lock.json /
RUN --mount=type=cache,id=wingtip-npm,target=/root/.npm \
    cd / && npm ci --no-audit --no-fund --loglevel=error
ENV PATH=/node_modules/.bin:$PATH
EOF
        rm -rf "$ctx"
      fi
    fi
    if [ -n "$tag" ]; then
      note "web: tsc${lint[0]:+, eslint} in $tag"
      hide=()
      [ -d "$here/apps/web/node_modules" ] && hide=(--tmpfs /repo/apps/web/node_modules)
      docker run --rm -v "$here:/repo" "${hide[@]+"${hide[@]}"}" -w /repo/apps/web "$tag" sh -c "$web_cmd" sh "${lint[@]+"${lint[@]}"}" || fail "web"
    else
      note "web: skipped, the wingtip-check-web image would not build"
    fi
  else
    note "web: skipped, neither node nor Docker is running here"
  fi
fi

# --- Python: ruff over the files changed, each under its own settings -------
py_files=$(grep -E '\.py$' <<<"$changed" | grep -v '^services/planner/app/detection\.py$' || true)
if [ -n "$py_files" ]; then
  # .tool-versions' ruff, as CI's and format.sh's: the PATH's only at that version.
  want_ruff=$("$here/scripts/build/toolchain.sh" get ruff)
  if command -v ruff >/dev/null && [ "$(ruff --version 2>/dev/null)" = "ruff $want_ruff" ]; then ruff=(ruff)
  elif command -v uvx >/dev/null; then ruff=(uvx -q "ruff@$want_ruff")
  else ruff=()
  fi
  if [ ${#ruff[@]} -gt 0 ]; then
    note "python: ruff on $(wc -l <<<"$py_files" | tr -d ' ') file(s)"
    # .ruff.toml applies to every file: ruff finds the
    # nearest one from each path.
    (cd "$here" && while IFS= read -r f; do printf '%s\0' "$f"; done <<<"$py_files" \
      | xargs -0 "${ruff[@]}" check --force-exclude --) || fail "ruff"
  else
    note "python: skipped, no ruff or uvx here"
  fi
fi

# --- engine: cargo check over the crates CI tests ---------------------------
if has_area engine; then
  if command -v cargo >/dev/null && cargo --version >/dev/null 2>&1; then
    # CI's own crate list (ci.yml's test job), so this checks what CI tests;
    # a target directory per worktree, keyed by its path. One shared by every
    # worktree failed falsely: Cargo took another worktree's newer build of a
    # crate of ours, at another path, for this one's (2026-11-08).
    read -ra pkgs <<<"$(grep -oE 'cargo test --profile ci [^#]*' "$here/.github/workflows/ci.yml" | head -1 | grep -oE -- '-p [a-z0-9-]+' | xargs)"
    note "engine: cargo check"
    # The directories of worktrees not pushed from in two weeks go (a cold
    # check at worst).
    find "$HOME/Library/Caches/wingtip-pre-push-cargo" -mindepth 1 -maxdepth 1 -type d -mtime +14 -exec rm -rf {} + 2>/dev/null || true
    # Keyed by the lock's hash as well: the same path with another lock gave
    # a false "cannot find `performance` in `wingtip_flight`" while a clean
    # target passed (2026-11-08), so a failure is tried once more on a clean
    # target, and only that second result counts.
    lockkey=$(shasum -a 256 "$here/engine/Cargo.lock" 2>/dev/null | cut -c1-8)
    target=${WINGTIP_HOOK_CARGO_TARGET:-$HOME/Library/Caches/wingtip-pre-push-cargo/$(basename "$repo")-$(printf '%s' "$repo" | shasum -a 256 | cut -c1-8)-${lockkey:-nolock}}
    mkdir -p "$target" && printf '%s\n' "$repo" > "$target/.worktree"   # for tidy-local.sh
    if ! CARGO_TARGET_DIR=$target cargo check -q --manifest-path "$here/engine/Cargo.toml" "${pkgs[@]}"; then
      note "engine: cargo check failed; once more on a clean target"
      rm -rf "$target"
      CARGO_TARGET_DIR=$target cargo check -q --manifest-path "$here/engine/Cargo.toml" "${pkgs[@]}" || fail "cargo check"
    fi
  else
    note "engine: skipped, no Rust toolchain here (CI checks it)"
  fi
fi

# --- the formatters, for the languages the push changes ----------------------
# scripts/dev/format.sh --check, each language's tool at its pinned version,
# over that language's whole tree (seconds each). Nothing here runs in
# Docker: Prettier without node on this machine, and the Java without mvn,
# are left to CI, as the web's tsc is.
fmt=()
grep -qE '^(apps/web/.*\.(ts|tsx|js|jsx|mjs|cjs|css|json|jsonc|md)|scripts/build/.*\.mjs|\.prettierrc\.yaml)$' <<<"$changed" && fmt+=(web)
grep -qE '(\.py$|^\.ruff\.toml$)' <<<"$changed" && fmt+=(python)
grep -qE '^engine/.*(\.rs|rustfmt\.toml)$' <<<"$changed" && fmt+=(rust)
grep -qE '^apps/ios/(.*\.swift|\.swiftformat)$' <<<"$changed" && fmt+=(swift)
grep -qE '(^apps/android/.*\.kts?$|^\.editorconfig$)' <<<"$changed" && fmt+=(kotlin)
grep -qE '^services/gateway/(.*\.java|pom\.xml)$' <<<"$changed" && fmt+=(java)
if [ ${#fmt[@]} -gt 0 ]; then
  note "format: ${fmt[*]}"
  "$here/scripts/dev/format.sh" --check --no-docker "${fmt[@]}"
  case $? in
    0) ;;
    2) note "format: a language above was skipped (its tool is not here; CI checks it)" ;;
    *) fail "format (scripts/dev/format.sh ${fmt[*]} formats them)" ;;
  esac
fi

# --- the layering and the file budget: seconds, the standard library ---------
if has_area engine; then
  note "engine: the crates' layering"
  out=$(python3 "$here/scripts/ci/engine_layers.py") || { grep "::error" <<<"$out"; fail "engine layers"; }
fi
if has_area arch; then
  note "arch: the file-size budget"
  out=$(python3 "$here/scripts/ci/file_sizes.py" --base origin/main) || { grep "::error" <<<"$out"; fail "file sizes"; }
  note "arch: every version is .tool-versions'"
  out=$("$here/scripts/build/toolchain.sh" --check) || { grep "::error" <<<"$out"; fail "toolchain drift (scripts/build/toolchain.sh writes them)"; }
  note "arch: no raw style value outside the design tokens"
  out=$(python3 "$here/scripts/ci/brand_guard.py") || { grep -A3 "::error" <<<"$out"; fail "brand guard (design/tokens.json)"; }
fi

if [ "$failed" -ne 0 ]; then
  echo "pre-push: fix the above, or push anyway with git push --no-verify (or SKIP_HOOKS=1)"
  exit 1
fi
exit 0
