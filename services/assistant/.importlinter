# The assistant's import contracts, held by import-linter (`lint-imports`,
# run from this directory by scripts/ci/python_suite.sh's assistant leg).
# The assistant makes every Claude call and asks the planner for every
# figure through the generated client, which is a leaf under the service
# (CLAUDE.md, Architecture; the simplicity audit of 2026-11-12: weather and
# the assistant were the two services with no contract).
[importlinter]
root_packages =
    app
include_external_packages = False

[importlinter:contract:only-main-imports-main]
name = only app.openapi imports app.main
type = forbidden
source_modules =
    app.*
forbidden_modules =
    app.main
ignore_imports =
    app.openapi -> app.main
unmatched_ignore_imports_alerting = error
allow_indirect_imports = True

[importlinter:contract:generated-client-is-a-leaf]
name = the generated planner client imports none of the hand-written modules
type = forbidden
source_modules =
    app.generated
forbidden_modules =
    app.main
    app.assistant
    app.toolbox
    app.coach
    app.rule_tools
    app.tool_answers
allow_indirect_imports = True
