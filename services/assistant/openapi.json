          },
          "editions": {
            "$ref": "#/components/schemas/OralEditions"
          },
          "key_points": {
            "items": {
              "type": "string"
            },
            "title": "Key Points",
            "type": "array"
          },
          "model_answer": {
            "title": "Model Answer",
            "type": "string"
          },
          "question": {
            "title": "Question",
            "type": "string"
          },
          "source_ids": {
            "items": {
              "type": "string"
            },
            "title": "Source Ids",
            "type": "array"
          },
