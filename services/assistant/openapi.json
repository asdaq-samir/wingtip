        "type": "object"
      },
      "NarrativeDelta": {
        "description": "A piece of the briefing as Claude writes it.",
        "properties": {
          "text": {
            "title": "Text",
            "type": "string"
          },
          "type": {
            "const": "delta",
            "default": "delta",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "NarrativeDelta",
        "type": "object"
      },
      "NarrativeDone": {
        "description": "The whole briefing, once it is written.",
        "properties": {
          "briefing": {
            "title": "Briefing",
            "type": "string"
          },
          "type": {
            "const": "done",
            "default": "done",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "briefing"
        ],
        "title": "NarrativeDone",
        "type": "object"
      },
      "NarrativeError": {
        "description": "Why there is no briefing, in words a pilot reads. It may come after\ndeltas: a failure once the first line is out cannot change the status\nany more.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "type": {
            "const": "error",
            "default": "error",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "NarrativeError",
        "type": "object"
      },
      "NarrativeLeg": {
        "additionalProperties": true,
        "description": "What the prompt reads from one leg, checked before a word of it is\nsent. The rest of a nav-log leg (its wind, its true airspeed and\ndensity altitude, its fixes) is kept and read where the prompt has a\nuse for it. A flyable leg (one with an ETE) needs its heading, ground\nspeed and fuel; an unflyable one needs none of them.",
        "properties": {
          "altitude_ft": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Altitude Ft"
          },
          "climb_min": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Climb Min"
          },
          "distance_nm": {
            "title": "Distance Nm",
            "type": "number"
          },
          "ete_min": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ete Min"
          },
          "from": {
            "maxLength": 80,
            "title": "From",
            "type": "string"
          },
          "fuel_gal": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fuel Gal"
          },
          "groundspeed_kt": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Groundspeed Kt"
          },
          "magnetic_heading_deg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Magnetic Heading Deg"
          },
          "to": {
            "maxLength": 80,
            "title": "To",
            "type": "string"
          }
        },
        "required": [
          "from",
          "to",
          "distance_nm"
        ],
        "title": "NarrativeLeg",
        "type": "object"
      },
      "NarrativeMessage": {
        "discriminator": {
          "mapping": {
            "delta": "#/components/schemas/NarrativeDelta",
            "done": "#/components/schemas/NarrativeDone",
            "error": "#/components/schemas/NarrativeError"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/NarrativeDelta"
          },
          {
            "$ref": "#/components/schemas/NarrativeDone"
          },
          {
            "$ref": "#/components/schemas/NarrativeError"
          }
        ]
      },
      "NarrativeRequest": {
        "description": "The nav log the Brief shows, to be told in words rather than\nrecomputed. `aircraft_name` omitted means the planner's own default\nairplane. `flown`, when sent, says whose altitudes the legs fly:\n\"custom\" for the pilot's own, else the planner's plan of that name.\n`altitude_selection` is the planner's reasoning for the altitude\n(the nav log's own), read field by field below.",
        "properties": {
          "aircraft_name": {
            "anyOf": [
              {
                "maxLength": 40,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Aircraft Name"
          },
          "altitude_ft": {
            "title": "Altitude Ft",
            "type": "number"
          },
          "altitude_selection": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Altitude Selection"
          },
          "departure_ident": {
            "maxLength": 10,
            "title": "Departure Ident",
            "type": "string"
          },
          "destination_ident": {
            "maxLength": 10,
            "title": "Destination Ident",
            "type": "string"
          },
          "flown": {
            "anyOf": [
              {
                "enum": [
                  "custom",
                  "lowest",
                  "highest",
                  "fastest",
                  "economical"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Flown"
          },
          "legs": {
            "items": {
              "$ref": "#/components/schemas/NarrativeLeg"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Legs",
            "type": "array"
          }
        },
        "required": [
          "departure_ident",
          "destination_ident",
          "altitude_ft",
          "legs"
        ],
        "title": "NarrativeRequest",
        "type": "object"
      },
      "NotamWords": {
        "description": "The NOTAM words, with since when the planner has heard the NOTAM\nfeed (ISO 8601 UTC; None where it has not yet): until the feed's\nfirst load of what was already in force, the list is not the whole\nlist for a field. `unchecked` names \"tfrs\" where tfr.faa.gov did not\nanswer, so an empty list does not read as no TFRs.",
        "properties": {
          "model": {
            "title": "Model",
            "type": "string"
          },
          "sentences": {
            "items": {
              "$ref": "#/components/schemas/Sentence"
            },
            "title": "Sentences",
            "type": "array"
          },
          "since": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Since"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "title": "Sources",
            "type": "array"
          },
          "unavailable": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unavailable"
          },
          "unchecked": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Unchecked",
            "type": "array"
          }
        },
        "required": [
          "sentences",
          "sources",
          "model"
        ],
        "title": "NotamWords",
        "type": "object"
      },
      "NoteCheckpoint": {
        "description": "`source` says where the text came from: \"saved\" is a pilot's own\nearlier edit, \"generated\" a fresh model call, \"error\" that call\nfailing for this checkpoint alone (`description` is None then).",
        "properties": {
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Detail"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "lat": {
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "title": "Lon",
            "type": "number"
          },
          "source": {
            "enum": [
              "generated",
              "saved",
              "error"
            ],
            "title": "Source",
            "type": "string"
          },
          "type": {
            "const": "checkpoint",
            "default": "checkpoint",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "lat",
          "lon",
          "id",
          "description",
          "source"
        ],
        "title": "NoteCheckpoint",
        "type": "object"
      },
      "NoteDone": {
        "properties": {
          "type": {
            "const": "done",
            "default": "done",
            "title": "Type",
            "type": "string"
          }
        },
        "title": "NoteDone",
        "type": "object"
      },
      "NoteError": {
        "description": "A failure that applies to every checkpoint the same way (a bad\nkey, an exhausted rate limit), sent once.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "type": {
            "const": "error",
            "default": "error",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "NoteError",
        "type": "object"
      },
      "NoteStart": {
        "properties": {
