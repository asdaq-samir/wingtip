        "title": "NoteStart",
        "type": "object"
      },
      "OralCitation": {
        "description": "A passage an answer rests on, quoted word for word (checked), with\nits source's title and where to read it.",
        "properties": {
          "quote": {
            "title": "Quote",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "source",
          "title",
          "url",
          "quote"
        ],
        "title": "OralCitation",
        "type": "object"
      },
      "OralEditions": {
        "description": "The editions the sources are: the eCFR's issue date and the day the\nAIM was read.",
