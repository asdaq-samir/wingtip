            },
            "maxItems": 12,
            "title": "Key Points",
            "type": "array"
          },
          "model_answer": {
            "maxLength": 4000,
            "title": "Model Answer",
            "type": "string"
          },
          "question": {
            "maxLength": 1000,
            "title": "Question",
            "type": "string"
          },
          "source_ids": {
            "items": {
              "maxLength": 40,
              "type": "string"
            },
            "maxItems": 12,
            "title": "Source Ids",
            "type": "array"
          }
        },
        "required": [
          "question",
          "model_answer",
          "source_ids",
          "answer"
        ],
        "title": "OralGradeRequest",
        "type": "object"
      },
