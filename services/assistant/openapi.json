              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Oral Grade"
      }
    },
    "/api/oral/question": {
      "post": {
        "description": "One question on one of the `focus` ACS elements, set in the flight\n`plan` describes, not one of those already `asked`; its answer from\nthe sources and the passages it quotes, each checked word for word.\nA 503 where the sources cannot be had, a 502 where the examiner\ncannot be reached.",
        "operationId": "oral_question_api_oral_question_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OralQuestionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OralQuestion"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Oral Question"
      }
    },
    "/api/words/changes": {
      "post": {
        "description": "What changed in a flight's briefing since the last look ({dep,\ndest, stops, then, now}), for a watch that reads the briefing again\nevery half hour. The changes are found by the planner, and the words\nasked only where there is one: most half hours there is none, and no\ncall at all.",
        "operationId": "changes_words_api_words_changes_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "description": "The reading's ask, as the planner's POST /api/words/{kind}/sources takes it.",
                "title": "Ask",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangesWords"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
