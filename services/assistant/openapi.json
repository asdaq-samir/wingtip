        "title": "OwnShip",
        "type": "object"
      },
      "Sentence": {
        "properties": {
          "sources": {
            "description": "The ids, exactly as given, of the sources this sentence rests on; at least one.",
            "items": {
              "type": "string"
            },
            "title": "Sources",
            "type": "array"
          },
          "text": {
            "description": "One short declarative sentence a pilot reads in the cockpit.",
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "sources"
        ],
        "title": "Sentence",
        "type": "object"
      },
      "Source": {
        "description": "The raw thing a sentence can rest on, as the pilot can read it: a\nMETAR or a NOTAM as sent, a TAF line, a hazard's words, a finding's\nline, a debrief figure's line. `id` is what a sentence cites\n(\"metar:KDLH\", \"finding:fuel\"); `label` is its heading on screen.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "text"
        ],
        "title": "Source",
        "type": "object"
      },
      "Turn": {
        "properties": {
          "content": {
            "maxLength": 24000,
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "role": {
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "title": "Turn",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WordsAnswer": {
        "description": "A words endpoint's answer: the sentences that passed the check, the\nsources they cite (for the pilot to read raw), which model wrote them,\nand -- with no sentences -- why the briefer could not be reached, where\nthat is why. No sentences and no `unavailable` is nothing to say.",
        "properties": {
          "model": {
            "title": "Model",
            "type": "string"
          },
          "sentences": {
            "items": {
              "$ref": "#/components/schemas/Sentence"
            },
            "title": "Sentences",
            "type": "array"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "title": "Sources",
            "type": "array"
          },
          "unavailable": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unavailable"
          }
        },
        "required": [
          "sentences",
          "sources",
          "model"
        ],
        "title": "WordsAnswer",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Wingtip Maps assistant",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "index__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Index"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Index"
      }
    },
    "/api/assistant": {
      "post": {
        "description": "The answer as events, one JSON object a line: `tool` (name, label)\nas each is asked, `text` (a piece of the answer) as it comes, `action`\nfor each change proposed, `sources` (id, label, text: the raw things\nthe answer rests on) once, then `done`; or `error` with the reason in\nwords. The conversation is sent whole each time, the pilot's turn\nlast; the context is the plan, position and record as the app has\nthem (AssistantAsk). One billed Claude conversation a question; the\ngateway lets signed-in pilots through (SecurityConfig).",
        "operationId": "ask_assistant_api_assistant_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssistantAsk"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              },
              "application/x-ndjson": {}
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ask Assistant"
      }
    },
    "/api/briefing/narrative": {
      "post": {
        "description": "The narrative as lines of NarrativeMessage: `delta` (a piece of\nthe text) as Claude writes it, then `done` with the whole briefing,\nor `error` with why there is none. The body is the nav log the Brief\nshows -- idents, airplane, cruise altitude and its selection, the\nlegs -- and is checked before Claude is asked, so a nav log the\nprompt cannot read is a 422 naming the field, not an error line.\nOne billed Claude call a narrative; the gateway lets only a\nsubscribed, signed-in pilot through, within the month's cap and the\nday's allowance (PlannerProxyController).",
        "operationId": "write_narrative_api_briefing_narrative_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NarrativeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              },
              "application/x-ndjson": {}
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Write Narrative"
      }
    },
    "/api/checkpoint-notes/generate": {
      "post": {
        "description": "One \"how to spot it\" line per checkpoint, as newline-delimited\nJSON (each line one CheckpointNoteMessage), so a slow LLM call on\ncheckpoint 3 does not hold up checkpoints 1 and 2 that already\narrived.\n\nTwo different kinds of failure, reported two different ways. A\nsingle checkpoint's own LLM call failing for a reason specific to\nit does not take the rest of the stream down -- every other\ncheckpoint is independent and still worth generating, so that one\ngets its own per-checkpoint \"error\" line and the loop moves on.\nGLOBAL_ANTHROPIC_ERRORS is the opposite case: a bad key or an\nexhausted rate limit fails identically for every checkpoint, so\nit's reported once as a single stream-level \"error\" (for one\nbanner instead of the same text repeated per row) -- but the\nstream itself keeps going: every remaining checkpoint still gets\nits own per-checkpoint \"error\" line too, just without spending a\ncall to learn what's already known. A pilot still gets a row to\ntype a note into for every checkpoint, not just the ones that\nhappened to come before the failure.\n\nA POST, not a GET: every checkpoint without a note is a billed\nClaude call and a write. The caller's own edit is what they see\nwhere they made one; generation only ever fills the shared note.\nThe route and its checkpoints are asked of the planner before the\nstream opens, so an ident that is not one is the planner's 404 here.",
        "operationId": "describe_checkpoints_api_checkpoint_notes_generate_post",
        "parameters": [
          {
            "in": "header",
            "name": "X-Pilot-Id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Pilot-Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateNotesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              },
              "application/x-ndjson": {}
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Describe Checkpoints"
      }
    },
    "/api/oral/grade": {
      "post": {
        "description": "The student's answer graded against the question's answer and the\nsources it was asked from (`source_ids`, as the question gave them).",
        "operationId": "oral_grade_api_oral_grade_post",
