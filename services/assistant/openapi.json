            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cfr Issued"
          }
        },
        "title": "OralEditions",
        "type": "object"
      },
      "OralFocus": {
        "description": "An ACS element the mock oral examines: its code and its words.",
        "properties": {
          "code": {
            "pattern": "^[A-Z]{2}\\.[IVX]+\\.[A-Z]\\.[KRS]\\d+[a-z]?$",
            "title": "Code",
            "type": "string"
          },
          "text": {
            "maxLength": 400,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "code",
          "text"
        ],
        "title": "OralFocus",
        "type": "object"
      },
      "OralGrade": {
        "description": "The student's answer graded: satisfactory, partial or unsatisfactory,\nin a few sentences, the key points it missed, and the citations.",
        "properties": {
          "citations": {
            "items": {
              "$ref": "#/components/schemas/OralCitation"
            },
            "title": "Citations",
            "type": "array"
          },
          "feedback": {
            "title": "Feedback",
            "type": "string"
          },
          "missed": {
            "items": {
              "type": "string"
            },
            "title": "Missed",
            "type": "array"
          },
          "verdict": {
            "enum": [
              "satisfactory",
              "partial",
              "unsatisfactory"
            ],
            "title": "Verdict",
            "type": "string"
          }
        },
        "required": [
          "verdict",
          "feedback",
          "missed",
          "citations"
        ],
        "title": "OralGrade",
        "type": "object"
      },
      "OralGradeRequest": {
        "properties": {
