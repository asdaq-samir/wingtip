# The jobs' import contracts, held by import-linter (`lint-imports`, run
# from this directory with services/planner on the path by
# scripts/ci/guards.sh's "Python imports"). Each job is one pipeline in one
# package, sharing only wingtip (retrain/ is an image over the planner's
# code, no package) (the simplicity audit of 2026-11-12, finding 8: one
# pipeline, one home): wingtip never reaches back into a job.
[importlinter]
root_packages =
    charts
    wingtip
include_external_packages = False

[importlinter:contract:wingtip-imports-no-job]
name = wingtip imports no job
type = forbidden
source_modules =
    wingtip
forbidden_modules =
    charts
