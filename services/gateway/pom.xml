<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.2.0-RC2</version>
        <relativePath/>
    </parent>

    <groupId>app.wingtipmaps</groupId>
    <artifactId>wingtip</artifactId>
    <version>0.1.0</version>
    <name>wingtip</name>
    <description>VFR route planning API -- proxies planner, persists saved routes.</description>

    <properties>
        <!-- 25, the current long-term-support Java: the JDK CI tests with
             and the eclipse-temurin:25-jre image the Dockerfile runs on.
             26 is a six-month release, out of support once 27 ships. -->
        <java.version>25</java.version>
        <!-- Newer than Spring Boot manages: the newest stable releases, as
             the owner asks of every tool. The compiler's 4.0 betas need
             Maven 4, which the build image is not yet. -->
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
        <!-- Newer than Spring Boot 4.2.0-RC2 manages (3.1.8, 2.21.8,
             3.1.5.RELEASE and 1.67.0), the newest on Maven Central on
             2026-11-12. Hibernate 8 (CR1) and Flyway 13 are left at
             Boot's 7.4 and 12.11: each a major past the one Boot 4.2 and
             Spring Data JPA are built and tested against. -->
        <jackson-bom.version>3.3.0</jackson-bom.version>
        <jackson-2-bom.version>2.23.0</jackson-2-bom.version>
        <thymeleaf.version>3.1.7.RELEASE</thymeleaf.version>
        <opentelemetry.version>1.68.0</opentelemetry.version>
    </properties>

    <dependencies>
        <!-- Generates the entities' getters. Compile-time only: the
             annotations are not on the runtime classpath and the jar
             below excludes it. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- The metadata of AppProperties (application.yml's app block),
             for the IDE's completion and Boot's own checks. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- RestClient and the HTTP interface clients Boot makes of the
             planner and the assistant (UpstreamClients, application.yml's
             spring.http.serviceclient). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <!-- The few pages a pilot sees outside the app (connecting an AI
             app, deleting an account without it): templates Thymeleaf
             escapes and Spring Security puts the CSRF field in, not HTML
             strings built by hand. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <!-- Bean Validation (@NotBlank/@Pattern on RouteRequest) and the
             @RestControllerAdvice global exception handler's use of
             MethodArgumentNotValidException; neither works without this. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Health/readiness for ALB target-group + ECS container health
             checks; see application.yml for the exposed groups. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Traces, to an OTLP collector, where management.tracing is on:
             Spring Boot's tracing module and the bridge and exporter it
             configures. Not spring-boot-starter-opentelemetry, which also
             brings the OTLP metrics registry, and with it a metrics export
             to a collector this app does not run. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <!-- Versioned schema migrations, replacing ddl-auto: update now that
             this is more than a stub; see db/migration/. The starter, not
             flyway-core alone: Spring Boot 4 runs migrations at start only
             with its Flyway module on the classpath. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- Sign-in with Google/Apple. Pulls in spring-boot-starter-security
             transitively, which is what secures the pilot-scoped
             endpoints; sessions are the servlet container's, so there is
             no token handling of our own to get wrong. Also the source
             of the Nimbus JOSE+JWT library OAuthClientsConfig uses to
             sign Apple's own client-secret JWT, a transitive dependency
             of spring-security-oauth2-jose, not declared separately. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-client</artifactId>
        </dependency>
        <!-- The OAuth 2.1 authorization server a pilot signs in through to
             connect Wingtip to their own Claude or ChatGPT (the MCP
             connector, docs/design/mcp-connector.md): Spring Security's
             own, stock, rather than tokens minted here by hand. Its
             tokens are for the planner's /mcp alone (security/mcp). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-authorization-server</artifactId>
        </dependency>
        <!-- Sessions kept in Postgres rather than the JVM's memory, so a
             sign-in survives a gateway restart (every rebuild used to sign
             everyone out) and can last the 30 days application.yml sets.
             The tables are Flyway's (V8), not created at startup. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-session-jdbc</artifactId>
        </dependency>
        <!-- The magic-link email flow's own sender. Configured, or left
             unconfigured (see application.yml's MAIL_HOST default), the
             same way Google/Apple's credentials are: present and working,
             or absent and failing closed, never a build-time requirement. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <!-- @WebMvcTest and MockMvc, with JUnit, Mockito and AssertJ. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- SimpleTracer, for the tracing package's tests. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- oidcLogin() and csrf() request post-processors, so the
             security rules are tested as rules rather than trusted. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Drives a real Postgres for the migration/persistence tests, so
             Flyway and the JPA mappings are verified against the database
             they actually run on rather than an in-memory substitute whose
             SQL dialect differs. Versions come from Spring Boot's parent. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Generates an OpenAPI spec + Swagger UI (/swagger-ui.html,
             /v3/api-docs) from the existing controller/DTO annotations;
             no hand-written spec to keep in sync. planner (FastAPI)
             already gets this for free at /docs; this gives the gateway the
             same thing. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.2.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- The Java's one layout (scripts/dev/format.sh java, or
                 `mvn spotless:apply`; `mvn spotless:check` in CI's gateway
                 job): palantir-java-format, Google's formatter at 120
                 columns with lambdas and chains kept closer to how they
                 are written here, through Spotless. src/main and src/test
                 only, Spotless's default, so target/generated-sources is
                 left as its generator writes it. -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <java>
                        <palantirJavaFormat>
                            <version>2.103.0</version>
                        </palantirJavaFormat>
                    </java>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Every lint, and a warning fails the build (the
                         owner's rule: no warnings). All but "processing",
                         which only says that no processor claimed the
                         Spring, JPA and Jackson annotations Lombok is
                         shown: they are read at run time, not by a
                         processor, so there is nothing to fix. Lombok
                         1.18.48 (the newest) still reads fields through
                         sun.misc.Unsafe, which the JDK warns of on
                         Maven's console: .mvn/jvm.config allows it. -->
                    <showWarnings>true</showWarnings>
                    <failOnWarning>true</failOnWarning>
                    <compilerArgs>
                        <arg>-Xlint:all,-processing</arg>
                    </compilerArgs>
                    <!-- Named explicitly, not picked up off the
                         classpath: from JDK 23 javac no longer runs
                         annotation processors it merely finds there,
                         and without this every Lombok-generated getter
                         is simply absent at compile time. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                            <version>${spring-boot.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                        <exclude>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!-- The assistant's answers this app reads itself (PlannerClient's
                 changes in words, for the flight watch), generated at
                 build time from the assistant service's committed
                 OpenAPI document rather than written out by hand, so a
                 field the assistant renames or drops fails this build
                 instead of reading as null in production. Models only:
                 the asking is Spring's HTTP interfaces (upstream/), which
                 Boot makes into clients; the generator's own
                 spring-http-interface library is still labelled testing.
                 Only the schemas read
                 here are generated (modelsToGenerate), prefixed Assistant
                 so "Source" and "Sentence" do not read as this app's own;
                 the browser's pass-through proxies read nothing and need
                 none. The Dockerfile copies the document to the same
                 place relative to the pom. -->
            <!-- The planner's and the assistant's committed OpenAPI
                 documents, into the jar at upstreams/{planner,assistant}/:
                 the routes the proxy forwards and who may call each are
                 read from their x-gateway extensions (UpstreamRoutes).
                 Built in rather than fetched from the planner at start, so
                 the jar's rules are the ones it was tested with and do not
                 wait on the planner being up. The Dockerfile copies both
                 beside the pom, as it does the assistant's above. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>upstream-routes-planner</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/upstreams/planner</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../planner</directory>
                                    <includes>
                                        <include>openapi.json</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>upstream-routes-assistant</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/upstreams/assistant</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../assistant</directory>
                                    <includes>
                                        <include>openapi.json</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>7.27.0</version>
                <executions>
                    <execution>
                        <id>assistant-models</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/../assistant/openapi.json</inputSpec>
                            <generatorName>spring</generatorName>
                            <modelPackage>app.wingtipmaps.gateway.assistant.model</modelPackage>
                            <modelNamePrefix>Assistant</modelNamePrefix>
                            <modelsToGenerate>ChangesWords,Sentence,Source</modelsToGenerate>
                            <generateApis>false</generateApis>
                            <generateSupportingFiles>false</generateSupportingFiles>
                            <generateModelTests>false</generateModelTests>
                            <generateModelDocumentation>false</generateModelDocumentation>
                            <!-- FastAPI writes an optional field as anyOf
                                 [type, null] (OpenAPI 3.1): read as a plain
                                 nullable field, not a wrapper type. -->
                            <openapiNormalizer>SIMPLIFY_ONEOF_ANYOF=true</openapiNormalizer>
                            <configOptions>
                                <useSpringBoot4>true</useSpringBoot4>
                                <useJackson3>true</useJackson3>
                                <useJspecify>true</useJspecify>
                                <generateJsonIncludeAnnotations>false</generateJsonIncludeAnnotations>
                                <generateJsonSetterNullsAnnotations>false</generateJsonSetterNullsAnnotations>
                                <openApiNullable>false</openApiNullable>
                                <useBeanValidation>false</useBeanValidation>
                                <documentationProvider>none</documentationProvider>
                                <annotationLibrary>none</annotationLibrary>
                                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                            </configOptions>
                        </configuration>
                    </execution>
                    <!-- The planner's asks and answers PlannerClient sends and
                         reads (the pilot's and the airplane's rules),
                         generated from the planner's committed document
                         the same way, prefixed Planner: a field the planner
                         renames or drops, or a type it changes, fails this
                         build at the line that uses it. A JSON number stays
                         the generator's BigDecimal: typeMappings number=Double
                         leaves LogbookEntry's defaults written as
                         `new BigDecimal("0")`, which does not compile, so
                         PlannerClient turns them to doubles itself. -->
                    <execution>
                        <id>planner-models</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/../planner/openapi.json</inputSpec>
                            <generatorName>spring</generatorName>
                            <modelPackage>app.wingtipmaps.gateway.planner.model</modelPackage>
                            <modelNamePrefix>Planner</modelNamePrefix>
                            <modelsToGenerate>CheckpointNote,PilotNotes,FeedHealth,FeedState,CurrencyAsk,Currency,LogbookEntry,ExperienceAsk,ExperienceItem,EndorsementsAsk,HeldEndorsement,Endorsements,ReviewCheck,EndorsementKind,EndorsementField,EndorsementFillAsk,EndorsementFilled,InspectionsAsk,VorCheckAsk,Inspections,VorCheck-Output,StudioDraft,StudioDraftCaptions,StudioDraftCheck,StudioDraftIdentity,StudioDraftNearest,StudioDraftQuote,StudioDraftSource,StudioDraftWindow,WordsSources,WordsSource</modelsToGenerate>
                            <generateApis>false</generateApis>
                            <generateSupportingFiles>false</generateSupportingFiles>
                            <generateModelTests>false</generateModelTests>
                            <generateModelDocumentation>false</generateModelDocumentation>
                            <openapiNormalizer>SIMPLIFY_ONEOF_ANYOF=true</openapiNormalizer>
                            <configOptions>
                                <useSpringBoot4>true</useSpringBoot4>
                                <useJackson3>true</useJackson3>
                                <useJspecify>true</useJspecify>
                                <generateJsonIncludeAnnotations>false</generateJsonIncludeAnnotations>
                                <generateJsonSetterNullsAnnotations>false</generateJsonSetterNullsAnnotations>
                                <openApiNullable>false</openApiNullable>
                                <useBeanValidation>false</useBeanValidation>
                                <documentationProvider>none</documentationProvider>
                                <annotationLibrary>none</annotationLibrary>
                                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <!-- Generated, and documented by the planner's own
                         document instead. -->
                    <excludePackageNames>app.wingtipmaps.gateway.assistant.model:app.wingtipmaps.gateway.planner.model</excludePackageNames>
                    <!-- Still catches malformed {@link}s, bad HTML, and
                         unknown tags; just doesn't demand a comment on
                         every trivial getter/DI constructor, where one
                         would be filler ("returns the id") rather than
                         real documentation. `mvn javadoc:javadoc`, output
                         in target/reports/apidocs. -->
                    <doclint>all,-missing</doclint>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
