# The weather service's import contracts, held by import-linter
# (`lint-imports`, run from this directory with services/planner on the
# path by scripts/ci/python_suite.sh's weather leg). The service writes
# the shared store from the outside feeds and holds no rule of its own
# (CLAUDE.md, Architecture; the simplicity audit of 2026-11-12: weather and
# the assistant were the two services with no contract).
[importlinter]
root_packages =
    app
    wingtip
include_external_packages = True

[importlinter:contract:wingtip-below-app]
name = wingtip never imports the weather service
type = forbidden
source_modules =
    wingtip
forbidden_modules =
    app

[importlinter:contract:no-claude-here]
name = the weather service makes no Claude call (the assistant makes every one)
type = forbidden
source_modules =
    app
forbidden_modules =
    anthropic
