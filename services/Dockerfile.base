# syntax=docker/dockerfile:1

# The one Python base every image that imports wingtip is built FROM
# (planner, the pipeline stages, the notebooks): Python, wingtip's
# own dependencies (services/planner/requirements-wingtip.txt) and wingtip's Rust extension
# (wingtip_native), installed once, here. Each image names it by the build
# context `wingtip-base` and adds only what it needs on top:
#
#   docker compose build           compose's `base` service, a
#                                  `service:base` context of each image
#   docker buildx bake             .github/images.hcl, `target:base`
#   docker build -f <Dockerfile> --build-context wingtip-base=docker-image://<a built base> .
#
# It replaced a byte-identical wingtip-native stage in each image's own
# Dockerfile (services/planner/tests_wingtip/test_dockerfiles.py kept the copies the same, 2026-11-05
# to 11-06): one stage now, built once, its layers stored once on disk
# and in the registry, where four copies each installed the same
# requirements into layers of their own.
#
# The wheel alone, as before:
#   docker build -f services/Dockerfile.base --target native -o out .

# Every image here and its sources pinned by digest, the tag kept beside
# it for a reader and for the end pass's update, which moves both
# together: a tag alone is whatever was pushed under it
# last, so the same commit could build on a different Python or Rust from
# one day to the next, and the cache keyed on it would miss.
#
# wingtip's Rust extension (engine/bindings/py, over wingtip-engine in
# engine/facade), which wingtip imports at module level since the shared
# engine (2026-11-03): built here, with Rust copied in from its own image,
# so the base carries the wheel and none of the toolchain.
FROM python:3.15-slim@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928 AS native
COPY --from=rust:1.99-slim-trixie@sha256:f6c4a35d21dbb3c89d7a8d056c193e94fc09037f2b58dd858b09c39a47dd02d7 /usr/local/cargo /usr/local/cargo
COPY --from=rust:1.99-slim-trixie@sha256:f6c4a35d21dbb3c89d7a8d056c193e94fc09037f2b58dd858b09c39a47dd02d7 /usr/local/rustup /usr/local/rustup
ENV PATH=/usr/local/cargo/bin:$PATH CARGO_HOME=/usr/local/cargo RUSTUP_HOME=/usr/local/rustup
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
    && apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev
RUN --mount=type=cache,target=/root/.cache/pip pip install maturin==1.16.0
COPY engine /engine
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    maturin build --release --compatibility linux -m /engine/bindings/py/Cargo.toml -o /wheels

FROM python:3.15-slim@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928 AS base

# wingtip's own list, before the wheel: it changes far less often than
# engine/, so an engine change rebuilds one small layer, not this one.
COPY services/planner/requirements-wingtip.txt /tmp/wingtip-requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip pip install -r /tmp/wingtip-requirements.txt \
    && rm /tmp/wingtip-requirements.txt
# The engine's wheel from the native stage above, mounted rather than
# copied, so no layer keeps it.
RUN --mount=type=bind,from=native,source=/wheels,target=/tmp/wheels \
    pip install --no-cache-dir --no-deps /tmp/wheels/*.whl
# The user every image runs as. Each image switches to it once its own
# files are in.
RUN useradd -m appuser
# The live store's folder, owned by the services' user, so an empty
# Docker volume mounted on it starts with that owner (docker-compose.yml).
RUN mkdir -p /live && chown appuser:appuser /live
# The build fails here if wingtip's own dependencies or its extension do
# not import, rather than each image that builds on this.
RUN python -B -c "import wingtip_native, numpy, pandas, requests, cachetools, tenacity, pyarrow.parquet, shapely.ops, shapefile, pyproj, pydantic_settings, scipy.spatial, pygeomag, tzfpy"
