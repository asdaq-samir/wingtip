# Settings for the local stack. `make dev` copies this to .env (gitignored,
# which Docker Compose reads) when there is none. Nothing here is required:
# every variable has a default in docker-compose.yml, whose header explains
# the phone and front-end settings. Never commit a .env.

# The Claude features (the assistant, the Brief's narrative, checkpoint
# notes, the words, the mock oral, a photographed page read, the flight
# watch's words) are OFF until the subscription is decided (the owner,
# 2026-11-10; docs/decisions/0035): no request reaches Anthropic, and the
# apps use on-device models and the engine's own words. To try them on
# this machine, set all three: the key, the gateway's switch (OFF,
# DEVELOPERS or EVERYONE) and the profile that starts the assistant.
ANTHROPIC_API_KEY=
APP_CLAUDE_FEATURES=OFF
# COMPOSE_PROFILES=claude

# Addresses that get the developer role on sign-in (the developer page and
# the training workspace). Comma-separated; developer@example.com is
# already one locally.
# APP_DEVELOPER_EMAILS=you@example.com

# Where the monitor's alerts go (a service down five minutes, a live feed
# stale; docs/OPERATIONS.md). Locally they land in the inbox at
# http://localhost:8025 as alerts@example.com unless this names yours.
# APP_ALERT_EMAILS=you@example.com

# The phone, over the Wi-Fi: see docs/LOCAL-DEV.md, "On a phone, over the
# Wi-Fi". Compose refuses to start with PUBLISH_ADDRESS set and the other
# two missing.
# PUBLISH_ADDRESS=0.0.0.0
# PHONE_BASE_URL=https://192.168.1.42:8443
# MAILPIT_UI_AUTH=user:password

# Front-end work without rebuilding the image (docs/LOCAL-DEV.md).
# COMPOSE_PROFILES=web-dev
# WEB_DIST_MOUNT=/app/static/app

# The AI connector (docs/MCP-CONNECTOR.md): off unless this is true. Its
# shared secret, MCP_INTERNAL_TOKEN, is written below by `make dev` (a random
# one, this machine's own); the repository holds none.
# MCP_ENABLED=true
