__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
data/raw/
.ipynb_checkpoints/
services/gateway/target/
.DS_Store
# The agent's own settings, which are a property of this machine rather
# than of this project: they set a permission mode and an allowlist, and
# a copy of them in a public repository is a copy that runs on whoever
# clones it. The skills are the exception: they say how this project is
# checked and shipped, and the agents in CI (the review and the autofix)
# read them from the checkout.
.claude/*
!.claude/skills/
# And the project's hooks, which carry no permission: the simplicity
# rules checked on each file an agent writes (scripts/dev/simplicity_hook.py;
# CLAUDE.md, "Simplicity rules"). A machine's own hooks and permissions stay
# in .claude/settings.local.json, not committed.
!.claude/settings.json

# The editor's per-machine state. The only file ever committed here was
# an empty setting VS Code's Python extension wrote on its own.
.vscode/

.env

# Trained model artifacts. Regenerable from the labels and code
# (collect -> engineer-features -> retrain -> promote, all seeded on
# RANDOM_STATE), and versions/ gains another copy on every promote, so
# these accumulate rather than settle.
data/models/
# The pilot's own ratings, made on this machine in the app (the chart
# picks) or before it (the older spottability ratings, emptied for fresh
# ones on 2026-10-01): hand judgment, kept on the machine and its iCloud
# copy, not in the repository -- committed, every rating made showed as a
# change, and the repository's copy was the old ratings the pilot had
# cleared. The checkpoint notes stay committed. And what the pipeline
# builds from a corridor's candidates: its features, and the map of them
# the data-collection notebook draws.
data/labels/chart_picks.csv
data/labels/spottability_ratings.csv
data/processed/features_*.parquet
data/processed/candidates_map.html
# The chart model's training table (wingtip.chartmodel), which the planner
# writes from the ratings when a retrain starts.
data/processed/chart_training.parquet


# The local HTTPS certificates infra/local-https/make-certs.sh writes: a
# private key and a CA for one machine, never for the repository.
infra/local-https/certs/

# iCloud writes a numbered copy beside a file it thinks two machines
# both changed ("main 2.tsx"). One of those was committed on
# 2026-09-22 by a `git add -A`: a stale duplicate of main.tsx that
# nothing imported and that had missed a change. They are never
# wanted here.
* [0-9].*

# wingtip.routecsv's lock files and the temporary files it renames into place.
data/labels/*.lock
data/labels/.*.tmp

# The native iOS app: XcodeGen makes the project on the runner.
apps/ios/Wingtip.xcodeproj
apps/ios/.build
apps/ios/Wingtip/Info.plist
apps/ios/Wingtip/Wingtip.entitlements
# And the Watch app's and the widgets' files it writes beside them.
apps/ios/WingtipWatch/Info.plist
apps/ios/WingtipWidgets/Info.plist
apps/ios/WingtipWidgets/WingtipWidgets.entitlements
# The engine for the app, built on the runner (engine/bindings/ffi/build-xcframework.sh).
apps/ios/Frameworks/

# The Rust extension's build output (engine/, built by maturin)
engine/target/

# The native Android app (apps/android/, docs/NATIVE-ANDROID.md): the engine
# built for it on the runner (engine/bindings/ffi/build-android.sh), Gradle's own
# state and output, and the SDK path a machine writes for itself.
apps/android/app/engine/
apps/android/.gradle/
apps/android/**/build/
# The native build state, which the Gradle plugin writes.
apps/android/app/.cxx/
apps/android/local.properties
# Android Studio's project state, and a machine's own compose overlay:
# both were kept out by .git/info/exclude under their old paths
# (android/.idea/), which the reorg (#536) left behind.
apps/android/.idea/
docker-compose.live.local.yml
docker-compose.override.yml
