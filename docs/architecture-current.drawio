      <mxCell id="e-charts-store" value="tiles" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;strokeColor=#444444;strokeWidth=1.5;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#FFFFFF;endArrow=classic;endFill=1;" edge="1" parent="1" source="charts-job" target="store"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="410" y="394" /><mxPoint x="410" y="674" /></Array></mxGeometry></mxCell>
      <mxCell id="legend" value="Solid line = a request or data flow.&amp;nbsp; Orange = a call into the engine, by a rule's name.&amp;nbsp; Dashed grey line = a hand-off outside the request path (the promoted model).&amp;nbsp; Dashed border = runs in-process.&amp;nbsp; The shared stores: ingest and weather write them, the charts job fills the tiles, the planner reads them and says when a feed goes stale; the live store is the live-store Docker volume (SQLite needs shared memory the Mac’s file sharing lacks), so no request waits on a live fetch (#535).&amp;nbsp; Services: gateway, planner, ingest, weather, db, mailpit; the jobs (retrain, charts, charts-overlays, charts-next), ml, web-build, jaeger and dev-services start only on request (their profiles)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="1375" width="1320" height="46" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>