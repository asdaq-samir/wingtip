<mxfile host="app.diagrams.net" type="device">
  <diagram name="Architecture (current)" id="wingtip-local-arch">
    <mxGraphModel dx="1400" dy="1170" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1170" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Wingtip Maps — architecture&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="400" y="14" width="600" height="34" as="geometry" /></mxCell>
        <mxCell id="grp-ml" value="ML pipeline — the chart model" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#5B84B1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#2C4E73;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="360" height="480" as="geometry" /></mxCell>
        <mxCell id="grp-apps" value="Apps — get data, keep state, draw (a view model per screen)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F6F7;strokeColor=#2E8C93;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#1D5A5F;" vertex="1" parent="1"><mxGeometry x="440" y="70" width="520" height="140" as="geometry" /></mxCell>
        <mxCell id="grp-servers" value="Servers (docker-compose.yml)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EAF7EE;strokeColor=#4A9A5C;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#2C6B3A;" vertex="1" parent="1"><mxGeometry x="440" y="230" width="520" height="320" as="geometry" /></mxCell>
        <mxCell id="grp-ext" value="Outside sources — the planner calls" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FDF9F0;strokeColor=#C79A3A;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#7A5A1A;" vertex="1" parent="1"><mxGeometry x="1000" y="70" width="360" height="480" as="geometry" /></mxCell>
        <mxCell id="grp-engine" value="The engine (Rust, engine/) — every aviation rule and figure, once · no network, no screen, no clock" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#D9822B;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#8A4B12;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="1320" height="360" as="geometry" /></mxCell>
        <mxCell id="grp-dev" value="Dev (not part of the serving path)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#888888;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#444444;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="860" height="125" as="geometry" /></mxCell>
        <mxCell id="grp-planned" value="Planned (#535): out of the planner, each at its trigger" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#999999;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#555555;dashed=1;dashPattern=6 4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="920" y="970" width="440" height="125" as="geometry" /></mxCell>
        <mxCell id="retrain" value='&lt;b&gt;retrain — the training run&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;training image · python -m wingtip.pipeline run&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;collect → features → retrain → evaluate → promote&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B84B1;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="70" y="112" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="pipeline-processing" value='&lt;b&gt;pipeline-processing&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;collect · engineer-features&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B84B1;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="70" y="222" width="140" height="64" as="geometry" /></mxCell>
        <mxCell id="pipeline-training" value='&lt;b&gt;pipeline-training&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;retrain&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B84B1;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="230" y="222" width="140" height="64" as="geometry" /></mxCell>
        <mxCell id="stages-note" value="The same stages one at a time, by hand: docker compose run --rm pipeline-processing collect." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#2C4E73;" vertex="1" parent="1"><mxGeometry x="70" y="290" width="300" height="34" as="geometry" /></mxCell>
        <mxCell id="model-registry" value='&lt;b&gt;model_registry.py&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;evaluate · promote: only a model that beats the serving one&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;(in-process in the training run, no container)&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B84B1;strokeWidth=1.5;fontSize=14;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="70" y="340" width="300" height="66" as="geometry" /></mxCell>
        <mxCell id="ml-note" value="Trained on the owner's ratings (data/labels) with scikit-learn; the promoted model is data/models/chart/current, which the planner reads again when it changes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#2C4E73;" vertex="1" parent="1"><mxGeometry x="70" y="420" width="300" height="60" as="geometry" /></mxCell>
        <mxCell id="web" value='&lt;b&gt;web&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;React · MapLibre GL&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;callEngine (WASM)&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E8C93;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="460" y="112" width="150" height="70" as="geometry" /></mxCell>
        <mxCell id="ios" value='&lt;b&gt;iOS&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;SwiftUI · MapKit&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;wt_call&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E8C93;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="630" y="112" width="150" height="70" as="geometry" /></mxCell>
        <mxCell id="android" value='&lt;b&gt;Android&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;Compose · MapLibre&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;JNI over wt_call&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E8C93;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="800" y="112" width="140" height="70" as="geometry" /></mxCell>
        <mxCell id="gateway" value='&lt;b&gt;gateway — Spring Boot&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;accounts · sign-in · saved records · public API&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;scheduled mail · serves the web bundle&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;no aviation logic; currency (61.56, 61.57) still Java, #482&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A9A5C;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="270" width="300" height="84" as="geometry" /></mxCell>
        <mxCell id="db" value='&lt;b&gt;db&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;PostgreSQL 18&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;accounts and records&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A9A5C;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="800" y="270" width="130" height="64" as="geometry" /></mxCell>
        <mxCell id="mailpit" value='&lt;b&gt;mailpit&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;the sign-in mail&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;a local inbox&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A9A5C;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="800" y="350" width="130" height="64" as="geometry" /></mxCell>
        <mxCell id="planner" value='&lt;b&gt;planner — FastAPI&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;over services/planner/wingtip: works out a flight&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;FAA + weather data · GFS winds aloft · traffic&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;chart tiles · FAA overlays as PMTiles (/api/overlay-tiles)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;chart model (scikit-learn, in-process) · checkpoints · nav log&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;assistant · Brief narrative · words (Anthropic SDK)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;asks the engine every rule&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A9A5C;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="384" width="300" height="150" as="geometry" /></mxCell>
        <mxCell id="claude-api" value="&lt;b&gt;Claude API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555555;&quot;&gt;Anthropic, through its SDK: the assistant,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555555;&quot;&gt;the Brief's narrative, checkpoint notes, words, oral&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDF6E8;strokeColor=#C79A3A;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1030" y="110" width="300" height="64" as="geometry" /></mxCell>
        <mxCell id="faa" value='&lt;b&gt;FAA&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;NASR · CIFP · obstacles · TFRs&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;chart sheets (sectional, TAC, IFR) · d-TPP plates&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDF6E8;strokeColor=#C79A3A;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1030" y="186" width="300" height="64" as="geometry" /></mxCell>
        <mxCell id="awc" value='&lt;b&gt;aviationweather.gov&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;METAR · TAF · PIREP · advisories&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDF6E8;strokeColor=#C79A3A;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1030" y="262" width="300" height="52" as="geometry" /></mxCell>
        <mxCell id="gfs" value='&lt;b&gt;NOAA NOMADS&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;GFS winds and temperatures aloft · GLMP&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDF6E8;strokeColor=#C79A3A;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1030" y="326" width="300" height="52" as="geometry" /></mxCell>
        <mxCell id="traffic" value='&lt;b&gt;Traffic&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;adsb.lol · ADS-B Exchange (RapidAPI)&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDF6E8;strokeColor=#C79A3A;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1030" y="390" width="300" height="52" as="geometry" /></mxCell>
        <mxCell id="swim" value='&lt;b&gt;FAA SWIM&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;STDDS · FNS · TFMS (app.swim)&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDF6E8;strokeColor=#C79A3A;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1030" y="454" width="300" height="52" as="geometry" /></mxCell>
        <mxCell id="facade" value='&lt;b&gt;wingtip-engine (facade)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;call.rs: each rule a name, JSON in and JSON out&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;faces: bindings/wasm (web) · bindings/py wingtip_native (planner)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;· bindings/ffi wt_call (iOS, Android)&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9822B;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="632" width="440" height="80" as="geometry" /></mxCell>
        <mxCell id="contract" value="&lt;b&gt;the contract&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555555;&quot;&gt;engine/contract/engine.schema.json: every name's input and answer&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555555;&quot;&gt;generates the web's contract.ts (npm run types) and&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555555;&quot;&gt;EngineContract.swift / .kt; held by facade/tests/contract.rs&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9822B;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="960" y="632" width="370" height="80" as="geometry" /></mxCell>
        <mxCell id="c-wording" value='&lt;b&gt;wording&lt;/b&gt; &lt;span style="font-size:10px;color:#555555;"&gt;wording&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9822B;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="732" width="440" height="32" as="geometry" /></mxCell>
        <mxCell id="c-airspace" value='&lt;b&gt;airspace&lt;/b&gt; &lt;span style="font-size:10px;color:#555555;"&gt;airspace · pack · pack_query · rules · view · spoken · ahead&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9822B;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="774" width="392" height="32" as="geometry" /></mxCell>
        <mxCell id="c-brief" value='&lt;b&gt;brief&lt;/b&gt; &lt;span style="font-size:10px;color:#555555;"&gt;gonogo · runway&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9822B;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="708" y="774" width="188" height="32" as="geometry" /></mxCell>
        <mxCell id="c-route" value='&lt;b&gt;route&lt;/b&gt; &lt;span style="font-size:10px;color:#555555;"&gt;route · motion · approach&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9822B;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="912" y="774" width="188" height="32" as="geometry" /></mxCell>
        <mxCell id="c-procedures" value='&lt;b&gt;procedures&lt;/b&gt; &lt;span style="font-size:10px;color:#555555;"&gt;figures: debrief · diversion · holding · lost comms · words&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9822B;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="816" width="392" height="32" as="geometry" /></mxCell>
        <mxCell id="c-radio" value='&lt;b&gt;radio&lt;/b&gt; &lt;span style="font-size:10px;color:#555555;"&gt;clearance · readback · atis&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9822B;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="708" y="816" width="188" height="32" as="geometry" /></mxCell>
        <mxCell id="c-pilot" value='&lt;b&gt;pilot&lt;/b&gt; &lt;span style="font-size:10px;color:#555555;"&gt;pilot · aircraft&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9822B;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="912" y="816" width="188" height="32" as="geometry" /></mxCell>
        <mxCell id="c-flight" value='&lt;b&gt;flight&lt;/b&gt; &lt;span style="font-size:10px;color:#555555;"&gt;wind triangle · 91.159 altitudes · 91.151 reserve · atmosphere&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9822B;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="858" width="392" height="32" as="geometry" /></mxCell>
        <mxCell id="c-weather" value='&lt;b&gt;weather&lt;/b&gt; &lt;span style="font-size:10px;color:#555555;"&gt;metar · taf · winds · forecast · notam · tfr&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9822B;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="708" y="858" width="392" height="32" as="geometry" /></mxCell>
        <mxCell id="crates-note" value="Ten crates, wingtip-&amp;lt;name&amp;gt; in engine/crates. Each may use only the crates under it, so the compiler keeps the direction; a new module goes in the lowest crate whose modules it needs." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#6A4A2A;" vertex="1" parent="1"><mxGeometry x="60" y="740" width="225" height="180" as="geometry" /></mxCell>
        <mxCell id="c-core" value='&lt;b&gt;core&lt;/b&gt; &lt;span style="font-size:10px;color:#555555;"&gt;geo · wmm · grid · sums · time · json · xml — no aviation rule&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9822B;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="900" width="800" height="32" as="geometry" /></mxCell>
        <mxCell id="engine-note" value="The same bytes run in the planner, the browser and both phones. Rules still written outside the engine move in by issue #482." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#6A4A2A;" vertex="1" parent="1"><mxGeometry x="1120" y="740" width="225" height="180" as="geometry" /></mxCell>
        <mxCell id="ml" value='&lt;b&gt;ml&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;Jupyter · the notebooks&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;(notebooks profile)&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="1010" width="190" height="64" as="geometry" /></mxCell>
        <mxCell id="dev-services" value='&lt;b&gt;dev-services&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;Docker sidecar: lets the developer&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;console start ml and retrain&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="265" y="1010" width="200" height="64" as="geometry" /></mxCell>
        <mxCell id="web-build" value='&lt;b&gt;web-build&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;vite --watch into apps/web/dist&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555;"&gt;(web-dev profile)&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="480" y="1010" width="200" height="64" as="geometry" /></mxCell>
