{
  "x-call": "wingtip_pilot::autolog::call",
  "description": "A logbook entry drawn from the app's own flown track, a draft for the pilot to change and confirm: 14 CFR 1.1's flight time and night, 61.57's landings (full stop or touch-and-go, 61.57(b)'s period), the approaches matched to the CIFP procedures given and the holds (61.57(c), offered apart in `instrument`: they count only when flown by instruments, 61.51(g)(1)), cross-country by 61.1(b), and a reason for each figure.",
  "type": "object",
  "properties": {
    "input": {
      "title": "LogbookFromTrackInput",
      "type": "object",
      "properties": {
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TrackPoint"
          },
          "description": "The track, in any order; put in time order first."
        },
        "fields": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/LogbookTrackField"
          },
          "description": "The fields near the places logbook_track_places named."
        },
        "drawings": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/ProcedureDrawing"
          },
          "description": "Those fields' approaches, as /api/procedure draws them."
        },
        "picked": {
          "type": [
            "string",
            "null"
          ],
          "description": "The approach picked for the flight, by its CIFP id."
        },
        "aircraft": {
          "type": [
            "string",
            "null"
          ]
        },
        "aircraft_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "utc_offset_min": {
          "type": [
            "number",
            "null"
          ],
          "description": "The pilot's clock against UTC, minutes; 0 where left out."
        }
      },
      "required": [
        "points"
      ]
    },
    "answer": {
      "title": "LogbookFromTrackAnswer",
      "type": "object",
      "properties": {
        "entry": {
          "title": "LogbookDraftEntry",
          "type": "object",
          "properties": {
            "flownOn": {
              "type": "string",
              "description": "YYYY-MM-DD on the pilot's clock (61.51(b)(1)(i))."
            },
            "aircraft": {
              "type": [
                "string",
                "null"
              ]
            },
            "aircraftType": {
              "type": [
                "string",
                "null"
              ]
            },
            "route": {
              "type": "string"
            },
            "totalHours": {
              "type": "number",
              "description": "1.1's flight time, to the tenth."
            },
            "airHours": {
              "type": "number",
              "description": "Takeoff roll to landing roll, to the tenth."
            },
            "nightHours": {
              "type": "number",
              "description": "Of the flight time, in 1.1's night."
            },
            "crossCountryHours": {
              "type": "number",
              "description": "The flight time where a landing was more than 50 nm from the departure (61.1(b)(ii)), else 0."
            },
            "dayLandings": {
              "type": "number",
              "description": "Every landing not counted at night: 61.57(a)."
            },
            "nightLandings": {
              "type": "number",
              "description": "To a full stop in 61.57(b)'s period."
            },
            "touchAndGoes": {
              "type": "number",
              "description": "Of the day landings, the touch-and-goes (61.57(a) counts them, (b) does not)."
            },
            "toweredLandings": {
              "type": "number"
            },
            "distanceNm": {
              "type": "number"
            },
            "longestLegNm": {
              "type": "number"
            },
            "approaches": {
              "type": "number",
              "description": "0: added from `instrument` where flown by instruments."
            },
            "holding": {
              "type": "boolean"
            },
            "tracking": {
              "type": "boolean"
            },
            "remarks": {
              "type": "string"
            }
          },
          "required": [
            "flownOn",
            "aircraft",
            "aircraftType",
            "route",
            "totalHours",
            "airHours",
            "nightHours",
            "crossCountryHours",
            "dayLandings",
            "nightLandings",
            "touchAndGoes",
            "toweredLandings",
            "distanceNm",
            "longestLegNm",
            "approaches",
            "holding",
            "tracking",
            "remarks"
          ]
        },
        "instrument": {
          "title": "LogbookInstrument",
          "type": "object",
          "properties": {
            "approaches": {
              "type": "number"
            },
            "holding": {
              "type": "boolean"
            },
            "tracking": {
              "type": "boolean"
            }
          },
          "required": [
            "approaches",
            "holding",
            "tracking"
          ],
          "description": "61.57(c)(1)'s items the track shows, to add to the entry where flown by instruments."
        },
        "takeoffs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LogbookTakeoff"
          }
        },
        "landings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LogbookLanding"
          }
        },
        "approaches": {
          "type": "array",
          "items": {
            "title": "LogbookApproach",
            "type": "object",
            "properties": {
              "airport": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "faf_at": {
                "type": "number",
                "description": "When it crossed the final approach fix inbound, ms."
              },
              "outcome": {
                "enum": [
                  "landed",
                  "missed",
                  "unknown"
                ]
              },
              "also_fits": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "airport",
              "id",
              "name",
              "faf_at",
              "outcome",
              "also_fits"
            ]
          }
        },
        "holds": {
          "type": "array",
          "items": {
            "title": "LogbookHold",
            "type": "object",
            "properties": {
              "from": {
                "type": "number"
              },
              "to": {
                "type": "number"
              },
              "racetracks": {
                "type": "number"
              },
              "lat": {
                "type": "number"
              },
              "lon": {
                "type": "number"
              },
              "fix": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "from",
              "to",
              "racetracks",
              "lat",
              "lon",
              "fix"
            ]
          }
        },
        "block": {
          "title": "LogbookBlock",
          "type": "object",
          "properties": {
            "from": {
              "type": [
                "number",
                "null"
              ]
            },
            "to": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "from",
            "to"
          ]
        },
        "cross_country": {
          "title": "LogbookCrossCountry",
          "type": "object",
          "properties": {
            "landed_elsewhere": {
              "type": "boolean"
            },
            "over_50_nm": {
              "type": "boolean"
            },
            "farthest_nm": {
              "type": "number"
            }
          },
          "required": [
            "landed_elsewhere",
            "over_50_nm",
            "farthest_nm"
          ]
        },
        "ends_airborne": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "title": "LogbookReason",
            "type": "object",
            "properties": {
              "item": {
                "type": "string"
              },
              "says": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            },
            "required": [
              "item",
              "says",
              "source"
            ]
          }
        }
      },
      "required": [
        "entry",
        "instrument",
        "takeoffs",
        "landings",
        "approaches",
        "holds",
        "block",
        "cross_country",
        "ends_airborne",
        "reasons"
      ]
    }
  },
  "required": [
    "input",
    "answer"
  ],
  "additionalProperties": false
}
