{
  "x-call": "wingtip_pilot::pilot::calls::endorsed",
  "description": "A student's aeronautical experience for a private pilot certificate, airplane single-engine (14 CFR 61.109(a)), item by item as the logbook shows it on the day. The gateway's ExperienceItemDto each.",
  "type": "object",
  "properties": {
    "input": {
      "title": "PilotExperienceInput",
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LogbookEntry"
          }
        },
        "today": {
          "type": "string",
          "description": "YYYY-MM-DD."
        }
      },
      "required": [
        "entries",
        "today"
      ]
    },
    "answer": {
      "title": "PilotExperienceAnswer",
      "type": "array",
      "items": {
        "title": "ExperienceItem",
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "rule": {
            "type": "string",
            "description": "Its paragraph, \"61.109(a)(5)(ii)\"."
          },
          "label": {
            "type": "string"
          },
          "have": {
            "type": "number"
          },
          "need": {
            "type": "number"
          },
          "unit": {
            "enum": [
              "h",
              "landings",
              "flights"
            ]
          },
          "met": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "rule",
          "label",
          "have",
          "need",
          "unit",
          "met"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "input",
    "answer"
  ],
  "additionalProperties": false
}
