{
  "x-call": "wingtip_core::plate::call",
  "description": "Where a position is drawn on an approach plate's page, for own ship on the plate full screen as an EFB's geo-referenced plates draw it: the latitude and longitude through the plate's Lambert conformal conic projection on NAD 83's GRS 80 (Snyder, USGS Professional Paper 1395, eqs. 14-1, 14-2, 14-4, 14-15, 15-7 to 15-10) and the page's affine from its GeoPDF viewport (ISO 32000-2 12.9, as the planner fits it: PlateGeoreference), as fractions of the page's width from the left and its height from the top, with a true track turned onto the page (degrees clockwise from the page's up, null without a track). Null outside the plan view's box or inside an inset cut from it, the only part of a d-TPP plate drawn to scale being the plan view.",
  "type": "object",
  "properties": {
    "input": {
      "title": "PlatePagePointInput",
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        },
        "track_deg": {
          "type": ["number", "null"]
        },
        "georeference": {
          "title": "PlatePageGeoreference",
          "type": "object",
          "properties": {
            "lat_0": {
              "type": "number"
            },
            "lon_0": {
              "type": "number"
            },
            "lat_1": {
              "type": "number"
            },
            "lat_2": {
              "type": "number"
            },
            "to_page": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "width_pt": {
              "type": "number"
            },
            "height_pt": {
              "type": "number"
            },
            "plan_view": {
              "$ref": "#/definitions/PlatePageBox"
            },
            "insets": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/PlatePageBox"
              }
            }
          },
          "required": ["lat_0", "lon_0", "lat_1", "lat_2", "to_page", "width_pt", "height_pt", "plan_view"]
        }
      },
      "required": ["lat", "lon", "georeference"]
    },
    "answer": {
      "title": "PlatePagePointAnswer",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "rotation_deg": {
              "type": ["number", "null"]
            }
          },
          "required": ["x", "y", "rotation_deg"]
        }
      ]
    }
  },
  "required": ["input", "answer"],
  "additionalProperties": false
}
