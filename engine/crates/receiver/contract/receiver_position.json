{
  "x-call": "wingtip_receiver::calls::call",
  "description": "Own ship from the receiver's GPS or the device's (GDL 90 560-1058-00 Rev A 3.4, 3.5.1.6, 3.8). The receiver's Ownship Report is a fix only while the receiver is heard, its Heartbeat says GPS Pos Valid (3.1.1), the report is under 3 s old and not extrapolated (AC 120-76D 11.17.2.3's three seconds) and its NIC and NACp reach 14 CFR 91.227(c)(1)'s floor (NIC 7, under 0.2 nm; NACp 8, under 0.05 nm). It is used where the device has no fresh fix (a Wi-Fi iPad) or the receiver's is better by twice, the device's accuracy put on the EPU's 95%; the one in use is kept until the other is twice as good, and the device's is taken back the moment the receiver's goes. Height is the GPS's, MSL where the receiver says so (ForeFlight's ID message), else ellipsoid_ft alone for a geoid model; pressure altitude is a flight level only at and above 18,000 ft (14 CFR 91.121(a)(2), 1.1).",
  "type": "object",
  "properties": {
    "input": {
      "title": "ReceiverPositionInput",
      "type": "object",
      "properties": {
        "ownship": {
          "anyOf": [
            {
              "$ref": "#/definitions/ReceiverOwnship"
            },
            {
              "type": "null"
            }
          ],
          "description": "The picture's own ship."
        },
        "receiver": {
          "anyOf": [
            {
              "$ref": "#/definitions/ReceiverState"
            },
            {
              "type": "null"
            }
          ],
          "description": "The picture's receiver."
        },
        "device": {
          "anyOf": [
            {
              "title": "ReceiverPositionDevice",
              "type": "object",
              "properties": {
                "accuracy_m": {
                  "type": "number",
                  "description": "The device's horizontal accuracy, m (a 68% radius)."
                },
                "at": {
                  "type": "number",
                  "description": "When the device's fix was taken, Unix s."
                }
              },
              "required": [
                "accuracy_m",
                "at"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "The device's last fix, or null where it has none."
        },
        "was": {
          "type": [
            "string",
            "null"
          ],
          "description": "The source the last answer gave (receiver, device or none)."
        },
        "at": {
          "type": "number",
          "description": "Now, Unix s."
        }
      },
      "required": [
        "at"
      ]
    },
    "answer": {
      "title": "ReceiverPositionAnswer",
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "receiver",
            "device",
            "none"
          ],
          "description": "Whose fix own ship is."
        },
        "receiver": {
          "type": "string",
          "enum": [
            "good",
            "none",
            "no_gps",
            "stale",
            "weak"
          ],
          "description": "The receiver's fix: good, or why it is not used (none heard, no GPS, stale, under 91.227's NIC and NACp)."
        },
        "fix": {
          "anyOf": [
            {
              "title": "ReceiverFix",
              "type": "object",
              "properties": {
                "lat": {
                  "type": "number"
                },
                "lon": {
                  "type": "number"
                },
                "altitude_ft": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "GPS height MSL, ft, where the receiver gives MSL."
                },
                "ellipsoid_ft": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "GPS height above the WGS-84 ellipsoid, ft, where that is what the receiver gives."
                },
                "pressure_ft": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Pressure altitude on 29.92 inHg, ft (GDL 90 3.5.1.4)."
                },
                "flight_level": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "The pressure altitude as a flight level, at and above 18,000 ft only."
                },
                "track_deg": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "True track, degrees, where the report gives one."
                },
                "groundspeed_kt": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "vertical_fpm": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "accuracy_m": {
                  "type": "number",
                  "description": "The NACp's bound on the 95% horizontal error, m."
                },
                "airborne": {
                  "type": "boolean"
                },
                "at": {
                  "type": "number",
                  "description": "When the report was heard, Unix s."
                }
              },
              "required": [
                "lat",
                "lon",
                "altitude_ft",
                "ellipsoid_ft",
                "pressure_ft",
                "flight_level",
                "track_deg",
                "groundspeed_kt",
                "vertical_fpm",
                "accuracy_m",
                "airborne",
                "at"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "The receiver's fix, where it is the source."
        }
      },
      "required": [
        "source",
        "receiver",
        "fix"
      ]
    }
  },
  "required": [
    "input",
    "answer"
  ],
  "additionalProperties": false
}
