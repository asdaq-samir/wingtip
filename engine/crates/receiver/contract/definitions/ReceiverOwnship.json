{
  "title": "ReceiverOwnship",
  "description": "Own ship as the receiver's GPS gives it.",
  "type": "object",
  "properties": {
    "hex": {
      "type": "string",
      "description": "The address as the internet's traffic writes it: six lower-case hex digits, a ~ before one that is not an ICAO address."
    },
    "address": {
      "type": "number",
      "description": "The 24-bit participant address (GDL 90 3.5.1.3)."
    },
    "address_type": {
      "type": "number",
      "description": "0 ADS-B with an ICAO address, 1 ADS-B self-assigned, 2 TIS-B ICAO, 3 TIS-B track file, 4 surface vehicle, 5 ground station beacon (GDL 90 3.5.1.2)."
    },
    "source": {
      "type": "string",
      "enum": [
        "ADS-B",
        "TIS-B",
        "vehicle",
        "beacon"
      ]
    },
    "callsign": {
      "type": [
        "string",
        "null"
      ]
    },
    "lat": {
      "type": "number"
    },
    "lon": {
      "type": "number"
    },
    "pressure_ft": {
      "type": [
        "number",
        "null"
      ],
      "description": "Pressure altitude on 29.92 inHg, ft (GDL 90 3.5.1.4)."
    },
    "airborne": {
      "type": "boolean"
    },
    "extrapolated": {
      "type": "boolean"
    },
    "track_deg": {
      "type": [
        "number",
        "null"
      ]
    },
    "track_kind": {
      "type": "string",
      "enum": [
        "track",
        "heading",
        "magnetic"
      ],
      "description": "True track, true heading or magnetic heading (GDL 90 3.5.1.5)."
    },
    "speed_kt": {
      "type": [
        "number",
        "null"
      ]
    },
    "vertical_fpm": {
      "type": [
        "number",
        "null"
      ]
    },
    "emitter": {
      "type": "number",
      "description": "GDL 90's emitter category code (3.5.1.10)."
    },
    "category": {
      "type": [
        "string",
        "null"
      ],
      "description": "DO-260B's emitter category, A1 light to C5 line obstacle."
    },
    "emergency": {
      "type": "number",
      "description": "0 none, 1 general, 2 medical, 3 minimum fuel, 4 no communication, 5 unlawful interference, 6 downed aircraft (GDL 90 3.5.1.12)."
    },
    "nic": {
      "type": "number",
      "description": "Navigation Integrity Category."
    },
    "nacp": {
      "type": "number",
      "description": "Navigation Accuracy Category for Position."
    },
    "alert": {
      "type": "boolean"
    },
    "at": {
      "type": "number",
      "description": "When it was last heard, Unix s."
    },
    "geometric_ft": {
      "type": [
        "number",
        "null"
      ],
      "description": "The GPS height (GDL 90 ID 11), ft: above MSL where the receiver says so (receiver.msl), else above the WGS-84 ellipsoid."
    },
    "vfom_m": {
      "type": [
        "number",
        "null"
      ],
      "description": "Its Vertical Figure of Merit, m."
    }
  },
  "required": [
    "hex",
    "address",
    "address_type",
    "source",
    "callsign",
    "lat",
    "lon",
    "pressure_ft",
    "airborne",
    "extrapolated",
    "track_deg",
    "track_kind",
    "speed_kt",
    "vertical_fpm",
    "emitter",
    "category",
    "emergency",
    "nic",
    "nacp",
    "alert",
    "at",
    "geometric_ft",
    "vfom_m"
  ]
}
