              "from",
              "to"
            ]
          }
        },
        "entry": {
          "type": "object",
          "properties": {
            "from": {
              "$ref": "#/definitions/PatternLegPoint"
            },
            "to": {
              "$ref": "#/definitions/PatternLegPoint"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "from",
            "to",
            "name"
          ]
        }
      },
      "required": [
        "kind",
        "ident",
        "runway",
        "traffic",
        "altitude_ft",
        "legs",
        "entry"
      ]
    },
    {
      "type": "null"
    }
  ],
  "description": "lib/trafficPattern's TrafficPattern in snake_case, or null where it cannot be drawn."
}
