{
  "title": "TrafficPatternOut",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "arrival",
            "departure"
          ]
        },
        "ident": {
          "type": "string"
        },
        "runway": {
          "type": "string"
        },
        "traffic": {
          "type": "string"
        },
        "altitude_ft": {
          "type": [
            "number",
            "null"
          ]
        },
        "legs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "enum": [
                  "Upwind",
                  "Crosswind",
                  "Downwind",
                  "Base",
                  "Final"
                ]
              },
              "from": {
